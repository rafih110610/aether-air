#! Friendly compatibility aliases
def.fun: Client(token:string) -> dynamic
    def.var: allIntents
        dynamic
        {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}
    def.var: auth
        string
        "Bot " + token
    def.var: authed
        dynamic
        {"prefix": "!", "intents": allIntents, "intents_value": 54019, "token": token, "auth": auth, "commands": [], "events": [], "ready": FALSE, "presence_status": "online", "presence_afk": FALSE, "presence_activities": []}
    Give: authed

def.fun: Bot(token:string) -> dynamic
    def.var: allIntents
        dynamic
        {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}
    def.var: auth
        string
        "Bot " + token
    def.var: authed
        dynamic
        {"prefix": "!", "intents": allIntents, "intents_value": 54019, "token": token, "auth": auth, "commands": [], "events": [], "ready": FALSE, "presence_status": "online", "presence_afk": FALSE, "presence_activities": []}
    Give: authed

def.fun: UseToken(token:string) -> dynamic
    def.var: allIntents
        dynamic
        {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}
    def.var: auth
        string
        "Bot " + token
    def.var: authed
        dynamic
        {"prefix": "!", "intents": allIntents, "intents_value": 54019, "token": token, "auth": auth, "commands": [], "events": [], "ready": FALSE, "presence_status": "online", "presence_afk": FALSE, "presence_activities": []}
    ActiveToken is token
    ActiveSession is authed
    ActivePresenceStatus is "online"
    ActivePresenceAfk is FALSE
    ActivePresenceActivities is []
    Give: authed

def.fun: UseBot(bot:dynamic) -> dynamic
    def.var: hasToken
        dynamic
        has_key;
            bot
            "token"
    if not hasToken:
        flag: "UseBot expects a bot object with token."
    if bot["token"] == "":
        flag: "UseBot expects bot token to be set. Use WithToken first."
    ActiveToken is bot["token"]
    ActiveSession is bot

    def.var: hasPresenceStatus
        dynamic
        has_key;
            bot
            "presence_status"
    if hasPresenceStatus:
        ActivePresenceStatus is bot["presence_status"]
    otherwise:
        ActivePresenceStatus is "online"

    def.var: hasPresenceAfk
        dynamic
        has_key;
            bot
            "presence_afk"
    if hasPresenceAfk:
        ActivePresenceAfk is bot["presence_afk"]
    otherwise:
        ActivePresenceAfk is FALSE

    def.var: hasPresenceActivities
        dynamic
        has_key;
            bot
            "presence_activities"
    if hasPresenceActivities:
        ActivePresenceActivities is bot["presence_activities"]
    otherwise:
        ActivePresenceActivities is []

    Give: bot

def.fun: AddTextCommand(bot:dynamic, name:string, response:string) -> dynamic
    def.var: loweredName
        string
        lower;
            name
    def.var: cmd
        dynamic
        {"name": loweredName, "aliases": [], "help": "", "usage": loweredName, "category": "general", "cooldown_seconds": 0, "response": response}
    def.var: commandsNow
        dynamic
        append;
            bot["commands"]
            cmd
    def.var: updated
        dynamic
        dict_set;
            bot
            "commands"
            commandsNow
    Give: updated

