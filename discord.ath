#! discord.ath
#! Discord.py-inspired starter module for Aether.

def.var: APIBase
    string
    "https://discord.com/api/v10"

def.var: GatewayBase
    string
    "wss://gateway.discord.gg"

def.var: ActiveToken
    string
    ""

def.var: ActiveSession
    dynamic
    {}

def.fun: IntentsDefault() -> dynamic
    Give: {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": FALSE, "guild_members": FALSE, "guild_presences": FALSE, "typing": FALSE, "reactions": TRUE}

def.fun: IntentsAll() -> dynamic
    Give: {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}

def.fun: IntentsDefaultValue() -> int
    Give: 513

def.fun: IntentsMessageContentValue() -> int
    Give: 33281

def.fun: CreateBot(prefix:string, intents:dynamic) -> dynamic
    Give: {"prefix": prefix, "intents": intents, "token": "", "auth": "", "commands": [], "events": []}

def.fun: WithToken(bot:dynamic, token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    Give: {"prefix": bot["prefix"], "intents": bot["intents"], "token": token, "auth": auth, "commands": bot["commands"], "events": bot["events"]}

def.fun: Login(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    def.var: me
        dynamic
        http_get(APIBase + "/users/@me", auth)
    Give: {"token": token, "auth": auth, "session": me}

def.fun: GatewayInfo(bot:dynamic) -> dynamic
    Give: http_get(APIBase + "/gateway/bot", bot["auth"])

def.fun: GatewayOpen(url:string) -> dynamic
    Give: ws_connect(url + "?v=10&encoding=json")

def.fun: GatewayIdentify(socketId:int, token:string, intents:int) -> dynamic
    def.var: identify
        dynamic
        {"op": 2, "d": {"token": token, "intents": intents, "properties": {"os": "aether", "browser": "aether", "device": "aether"}}}
    Give: ws_send_text(socketId, json_dumps(identify))

def.fun: GatewayHeartbeat(socketId:int, seq:int) -> dynamic
    def.var: heartbeat
        dynamic
        {"op": 1, "d": seq}
    Give: ws_send_text(socketId, json_dumps(heartbeat))

def.fun: GatewayRecv(socketId:int) -> dynamic
    def.var: packet
        dynamic
        ws_recv_text(socketId)
    if packet["ok"]:
        Give: {"ok": TRUE, "socket_id": socketId, "raw": packet["text"], "event": json_loads(packet["text"])}
    Give: packet

def.fun: GatewayClose(socketId:int) -> dynamic
    Give: ws_close(socketId)

def.fun: IsSuccess(result:dynamic) -> boolean
    Give: result["ok"]

def.fun: StatusCode(result:dynamic) -> int
    Give: result["status"]

def.fun: BodyText(result:dynamic) -> string
    Give: result["body"]

def.fun: Command(name:string, description:string) -> dynamic
    Give: {"type": "command", "name": name, "description": description}

def.fun: Event(name:string) -> dynamic
    Give: {"type": "event", "name": name}

def.fun: BuildMessage(channelId:string, content:string) -> dynamic
    Give: {"channel_id": channelId, "content": content, "tts": FALSE}

def.fun: SendMessage(bot:dynamic, channelId:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages"
    def.var: payload
        dynamic
        {"content": content}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: SendRichMessage(bot:dynamic, channelId:string, payload:dynamic) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages"
    Give: http_post_json(route, payload, bot["auth"])

def.fun: SendEmbedMessage(bot:dynamic, channelId:string, embed:dynamic) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages"
    def.var: payload
        dynamic
        {"embeds": [embed]}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: EditMessage(bot:dynamic, channelId:string, messageId:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId
    def.var: payload
        dynamic
        {"content": content}
    Give: http_patch_json(route, payload, bot["auth"])

def.fun: DeleteMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId
    Give: http_delete(route, bot["auth"])

def.fun: TriggerTyping(bot:dynamic, channelId:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/typing"
    Give: http_post_json(route, {}, bot["auth"])

def.fun: AddReaction(bot:dynamic, channelId:string, messageId:string, emoji:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    Give: http_put_json(route, {}, bot["auth"])

def.fun: RemoveOwnReaction(bot:dynamic, channelId:string, messageId:string, emoji:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    Give: http_delete(route, bot["auth"])

def.fun: GetMe(bot:dynamic) -> dynamic
    Give: http_get(APIBase + "/users/@me", bot["auth"])

def.fun: GetGuild(bot:dynamic, guildId:string) -> dynamic
    Give: http_get(APIBase + "/guilds/" + guildId, bot["auth"])

def.fun: GetChannel(bot:dynamic, channelId:string) -> dynamic
    Give: http_get(APIBase + "/channels/" + channelId, bot["auth"])

def.fun: GetMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    Give: http_get(APIBase + "/channels/" + channelId + "/messages/" + messageId, bot["auth"])

def.fun: CreateDM(bot:dynamic, userId:string) -> dynamic
    Give: http_post_json(APIBase + "/users/@me/channels", {"recipient_id": userId}, bot["auth"])

def.fun: SendDM(bot:dynamic, userId:string, content:string) -> dynamic
    def.var: dm
        dynamic
        CreateDM(bot, userId)
    if dm["ok"]:
        def.var: dmChannel
            dynamic
            json_loads(dm["body"])
        Give: SendMessage(bot, dmChannel["id"], content)
    Give: dm

def.fun: RegisterGlobalSlashCommand(bot:dynamic, appId:string, name:string, description:string) -> dynamic
    def.var: route
        string
        APIBase + "/applications/" + appId + "/commands"
    def.var: payload
        dynamic
        {"name": name, "description": description, "type": 1}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: ReplyInteraction(bot:dynamic, interactionId:string, interactionToken:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/interactions/" + interactionId + "/" + interactionToken + "/callback"
    def.var: payload
        dynamic
        {"type": 4, "data": {"content": content}}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: FollowupInteraction(bot:dynamic, appId:string, interactionToken:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/webhooks/" + appId + "/" + interactionToken
    def.var: payload
        dynamic
        {"content": content}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: BuildEmbed(title:string, description:string, color:int) -> dynamic
    Give: {"title": title, "description": description, "color": color}

def.fun: BuildAllowedMentions(parseEveryone:boolean, parseRoles:boolean, parseUsers:boolean) -> dynamic
    def.var: parse
        dynamic
        []
    if parseEveryone:
        make: parse = ["everyone"]
    if parseRoles:
        make: parse = parse + ["roles"]
    if parseUsers:
        make: parse = parse + ["users"]
    Give: {"parse": parse}

def.fun: ParseGatewayOpcode(eventPacket:dynamic) -> int
    Give: eventPacket["event"]["op"]

def.fun: ParseGatewaySeq(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["s"]

def.fun: ParseGatewayType(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["t"]

def.fun: ParseGatewayData(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["d"]

def.fun: IsGatewayDispatch(eventPacket:dynamic) -> boolean
    Give: discord.ParseGatewayOpcode(eventPacket) == 0

def.fun: IsGatewayHello(eventPacket:dynamic) -> boolean
    Give: discord.ParseGatewayOpcode(eventPacket) == 10

def.fun: IsGatewayHeartbeatAck(eventPacket:dynamic) -> boolean
    Give: discord.ParseGatewayOpcode(eventPacket) == 11

def.fun: GatewaySetPresence(socketId:int, status:string, afk:boolean) -> dynamic
    def.var: payload
        dynamic
        {"op": 3, "d": {"since": 0, "activities": [], "status": status, "afk": afk}}
    Give: ws_send_text(socketId, json_dumps(payload))

def.fun: GatewayRequestGuildMembers(socketId:int, guildId:string, query:string, limit:int) -> dynamic
    def.var: payload
        dynamic
        {"op": 8, "d": {"guild_id": guildId, "query": query, "limit": limit}}
    Give: ws_send_text(socketId, json_dumps(payload))

def.fun: SendWebhook(webhookUrl:string, content:string) -> dynamic
    Give: http_post_json(webhookUrl, {"content": content}, "")

def.fun: Mention(userId:string) -> string
    Give: "<@" + userId + ">"

def.fun: Channel(channelId:string) -> string
    Give: "<#" + channelId + ">"

def.fun: Role(roleId:string) -> string
    Give: "<@&" + roleId + ">"

def.fun: Emoji(name:string, emojiId:string) -> string
    Give: "<:" + name + ":" + emojiId + ">"

def.fun: ReadyPayload(botName:string) -> dynamic
    Give: {"status": "ready", "bot": botName, "gateway": GatewayBase}

#! =========================
#! Extended Discord.py-like REST Surface
#! =========================

def.fun: ApiGet(bot:dynamic, route:string) -> dynamic
    Give: http_get(APIBase + route, bot["auth"])

def.fun: ApiPost(bot:dynamic, route:string, payload:dynamic) -> dynamic
    Give: http_post_json(APIBase + route, payload, bot["auth"])

def.fun: ApiPut(bot:dynamic, route:string, payload:dynamic) -> dynamic
    Give: http_put_json(APIBase + route, payload, bot["auth"])

def.fun: ApiPatch(bot:dynamic, route:string, payload:dynamic) -> dynamic
    Give: http_patch_json(APIBase + route, payload, bot["auth"])

def.fun: ApiDelete(bot:dynamic, route:string) -> dynamic
    Give: http_delete(APIBase + route, bot["auth"])

def.fun: FetchUser(bot:dynamic, userId:string) -> dynamic
    Give: discord.ApiGet(bot, "/users/" + userId)

def.fun: FetchGuilds(bot:dynamic) -> dynamic
    Give: discord.ApiGet(bot, "/users/@me/guilds")

def.fun: FetchGuildChannels(bot:dynamic, guildId:string) -> dynamic
    Give: discord.ApiGet(bot, "/guilds/" + guildId + "/channels")

def.fun: FetchGuildRoles(bot:dynamic, guildId:string) -> dynamic
    Give: discord.ApiGet(bot, "/guilds/" + guildId + "/roles")

def.fun: FetchGuildMember(bot:dynamic, guildId:string, userId:string) -> dynamic
    Give: discord.ApiGet(bot, "/guilds/" + guildId + "/members/" + userId)

def.fun: EditGuildMemberNick(bot:dynamic, guildId:string, nick:string) -> dynamic
    Give: discord.ApiPatch(bot, "/guilds/" + guildId + "/members/@me", {"nick": nick})

def.fun: AddGuildMemberRole(bot:dynamic, guildId:string, userId:string, roleId:string) -> dynamic
    Give: discord.ApiPut(bot, "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId, {})

def.fun: RemoveGuildMemberRole(bot:dynamic, guildId:string, userId:string, roleId:string) -> dynamic
    Give: discord.ApiDelete(bot, "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId)

def.fun: BanMember(bot:dynamic, guildId:string, userId:string, deleteMessageSeconds:int) -> dynamic
    Give: discord.ApiPut(bot, "/guilds/" + guildId + "/bans/" + userId, {"delete_message_seconds": deleteMessageSeconds})

def.fun: UnbanMember(bot:dynamic, guildId:string, userId:string) -> dynamic
    Give: discord.ApiDelete(bot, "/guilds/" + guildId + "/bans/" + userId)

def.fun: BulkDeleteMessages(bot:dynamic, channelId:string, messageIds:dynamic) -> dynamic
    Give: discord.ApiPost(bot, "/channels/" + channelId + "/messages/bulk-delete", {"messages": messageIds})

def.fun: PinMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    Give: discord.ApiPut(bot, "/channels/" + channelId + "/pins/" + messageId, {})

def.fun: UnpinMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    Give: discord.ApiDelete(bot, "/channels/" + channelId + "/pins/" + messageId)

def.fun: FetchPinnedMessages(bot:dynamic, channelId:string) -> dynamic
    Give: discord.ApiGet(bot, "/channels/" + channelId + "/pins")

def.fun: CreateGuildTextChannel(bot:dynamic, guildId:string, name:string, topic:string) -> dynamic
    Give: discord.ApiPost(bot, "/guilds/" + guildId + "/channels", {"name": name, "type": 0, "topic": topic})

def.fun: EditChannel(bot:dynamic, channelId:string, payload:dynamic) -> dynamic
    Give: discord.ApiPatch(bot, "/channels/" + channelId, payload)

def.fun: DeleteChannel(bot:dynamic, channelId:string) -> dynamic
    Give: discord.ApiDelete(bot, "/channels/" + channelId)

def.fun: CreatePublicThread(bot:dynamic, channelId:string, messageId:string, name:string, autoArchiveMinutes:int) -> dynamic
    Give: discord.ApiPost(bot, "/channels/" + channelId + "/messages/" + messageId + "/threads", {"name": name, "auto_archive_duration": autoArchiveMinutes})

def.fun: CreateWebhook(bot:dynamic, channelId:string, name:string) -> dynamic
    Give: discord.ApiPost(bot, "/channels/" + channelId + "/webhooks", {"name": name})

def.fun: FetchApplication(bot:dynamic) -> dynamic
    Give: discord.ApiGet(bot, "/oauth2/applications/@me")

def.fun: FetchGlobalCommands(bot:dynamic, appId:string) -> dynamic
    Give: discord.ApiGet(bot, "/applications/" + appId + "/commands")

def.fun: CreateGlobalCommand(bot:dynamic, appId:string, commandPayload:dynamic) -> dynamic
    Give: discord.ApiPost(bot, "/applications/" + appId + "/commands", commandPayload)

def.fun: EditGlobalCommand(bot:dynamic, appId:string, commandId:string, commandPayload:dynamic) -> dynamic
    Give: discord.ApiPatch(bot, "/applications/" + appId + "/commands/" + commandId, commandPayload)

def.fun: DeleteGlobalCommand(bot:dynamic, appId:string, commandId:string) -> dynamic
    Give: discord.ApiDelete(bot, "/applications/" + appId + "/commands/" + commandId)

#! Friendly aliases for Python users
def.fun: Client(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    Give: {"prefix": "!", "intents": {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}, "token": token, "auth": auth, "commands": [], "events": []}

def.fun: Bot(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    Give: {"prefix": "!", "intents": {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}, "token": token, "auth": auth, "commands": [], "events": []}

def.fun: UseToken(token:string) -> dynamic
    def.var: authed
        dynamic
        {"prefix": "!", "intents": {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}, "token": token, "auth": "Bot " + token, "commands": [], "events": []}
    ActiveToken is token
    ActiveSession is authed
    Give: authed

def.fun: Session() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken(token) first."
    Give: ActiveSession

def.fun: IsSessionReady() -> boolean
    Give: ActiveToken != ""

def.fun: ClearSession() -> dynamic
    ActiveToken is ""
    ActiveSession is {}
    Give: empty

def.fun: SendWith(tokenOrBot:dynamic, channelId:string, content:string) -> dynamic
    if typeOf(tokenOrBot) == "string":
        Give: http_post_json("https://discord.com/api/v10" + "/channels/" + channelId + "/messages", {"content": content}, "Bot " + tokenOrBot)
    Give: http_post_json("https://discord.com/api/v10" + "/channels/" + channelId + "/messages", {"content": content}, tokenOrBot["auth"])

def.fun: Send(channelId:string, content:string) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken(token) first."
    Give: http_post_json("https://discord.com/api/v10" + "/channels/" + channelId + "/messages", {"content": content}, ActiveSession["auth"])

def.fun: SendEmbedWith(tokenOrBot:dynamic, channelId:string, title:string, description:string, color:int) -> dynamic
    def.var: embed
        dynamic
        {"title": title, "description": description, "color": color}
    if typeOf(tokenOrBot) == "string":
        Give: http_post_json("https://discord.com/api/v10" + "/channels/" + channelId + "/messages", {"embeds": [embed]}, "Bot " + tokenOrBot)
    Give: http_post_json("https://discord.com/api/v10" + "/channels/" + channelId + "/messages", {"embeds": [embed]}, tokenOrBot["auth"])

def.fun: SendEmbed(channelId:string, title:string, description:string, color:int) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken(token) first."
    Give: http_post_json("https://discord.com/api/v10" + "/channels/" + channelId + "/messages", {"embeds": [{"title": title, "description": description, "color": color}]}, ActiveSession["auth"])

def.fun: DMWith(tokenOrBot:dynamic, userId:string, content:string) -> dynamic
    if typeOf(tokenOrBot) == "string":
        Give: http_post_json("https://discord.com/api/v10" + "/users/@me/channels", {"recipient_id": userId}, "Bot " + tokenOrBot)
    Give: http_post_json("https://discord.com/api/v10" + "/users/@me/channels", {"recipient_id": userId}, tokenOrBot["auth"])

def.fun: DM(userId:string, content:string) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken(token) first."
    def.var: dm
        dynamic
        http_post_json("https://discord.com/api/v10" + "/users/@me/channels", {"recipient_id": userId}, ActiveSession["auth"])
    if dm["ok"]:
        def.var: dmChannel
            dynamic
            json_loads(dm["body"])
        Give: http_post_json("https://discord.com/api/v10" + "/channels/" + dmChannel["id"] + "/messages", {"content": content}, ActiveSession["auth"])
    Give: dm

def.fun: Verify(token:string) -> dynamic
    Give: http_get("https://discord.com/api/v10" + "/users/@me", "Bot " + token)

def.fun: FetchChannel(bot:dynamic, channelId:string) -> dynamic
    Give: discord.GetChannel(bot, channelId)

def.fun: FetchMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    Give: discord.GetMessage(bot, channelId, messageId)

