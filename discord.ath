        def.var: author
            dynamic
            payload["author"]
        def.var: authorHasBot
            dynamic
            has_key;
                author
                "bot"
        if authorHasBot:
            if author["bot"]:
                Give: {"handled": FALSE, "reason": "author_is_bot"}

    def.var: resolved
        dynamic
        {"matched": FALSE}

    def.var: prefix
        string
        bot["prefix"]
    def.var: startsWithPrefix
        dynamic
        starts_with;
            payload["content"]
            prefix
    if startsWithPrefix:
        def.var: prefixLen
            int
            len;
                prefix
        def.var: sliced
            string
            slice;
                payload["content"]
                prefixLen
                empty
        def.var: raw
            string
            trim;
                sliced

        if raw != "":
            def.var: parts
                list
                split;
                    raw
            def.var: partCount
                int
                len;
                    parts
            def.var: commandName
                string
                lower;
                    parts[0]
            def.var: args
                dynamic
                []
            if partCount > 1:
                args is slice;
                    parts
                    1
                    empty

            Repeat for cmd in bot["commands"]:
                def.var: matchedByName
                    boolean
                    FALSE
                def.var: cmdNameLower
                    string
                    lower;
                        cmd["name"]
                if cmdNameLower == commandName:
                    matchedByName is TRUE

                if not matchedByName:
                    def.var: cmdHasAliases
                        dynamic
                        has_key;
                            cmd
                            "aliases"
                    if cmdHasAliases:
                        Repeat for aliasName in cmd["aliases"]:
                            def.var: aliasLower
                                string
                                lower;
                                    string(aliasName)
                            if aliasLower == commandName:
                                matchedByName is TRUE

                if matchedByName:
                    def.var: hasResponse
                        dynamic
                        has_key;
                            cmd
                            "response"
                    if hasResponse:
                        resolved is {"matched": TRUE, "name": cmdNameLower, "response": cmd["response"], "args": args, "raw": raw, "command": cmd, "payload": payload}

                    def.var: hasAction
                        dynamic
                        has_key;
                            cmd
                            "action"
                    if hasAction:
                        resolved is {"matched": TRUE, "name": cmdNameLower, "action": cmd["action"], "args": args, "raw": raw, "command": cmd, "payload": payload}

    if not resolved["matched"]:
        Give: {"handled": FALSE}

    ActivePlaceholderContext is dict_set;
        ActivePlaceholderContext
        "command"
        resolved["name"]

    def.var: commandCooldownSeconds
        int
        0
    def.var: resolvedHasCommand
        dynamic
        has_key;
            resolved
            "command"
    if resolvedHasCommand:
        def.var: resolvedCommand
            dynamic
            resolved["command"]
        def.var: commandHasCooldown
            dynamic
            has_key;
                resolvedCommand
                "cooldown_seconds"
        if commandHasCooldown:
            commandCooldownSeconds is int;
                resolvedCommand["cooldown_seconds"]
            if commandCooldownSeconds < 0:
