                has_key;
                    author
                    "id"
            if authorHasId:
                authorId is string;
                    author["id"]

        if authorId != "":
            def.var: cooldownKey
                string
                resolved["name"] + "|" + authorId

            def.var: now
                float
                time_now;

            def.var: hasCooldownEntry
                dynamic
                has_key;
                    ActiveCommandCooldowns
                    cooldownKey
            if hasCooldownEntry:
                def.var: nextAvailable
                    float
                    float;
                        ActiveCommandCooldowns[cooldownKey]
                if now < nextAvailable:
                    def.var: remainingFloat
                        float
                        nextAvailable - now
                    def.var: remainingSeconds
                        int
                        int;
                            remainingFloat
                    if remainingSeconds < 1:
                        remainingSeconds is 1
                    def.var: cooldownMessage
