            "prefix"
    if hasPrefix:
        output is replace;
            output
            "{prefix}"
            string(ActivePlaceholderContext["prefix"])

    def.var: hasCommand
        dynamic
        has_key;
            ActivePlaceholderContext
            "command"
    if hasCommand:
        output is replace;
            output
            "{command}"
            string(ActivePlaceholderContext["command"])

    if argCount > 0:
        output is replace;
            output
            "{0}"
            string(args[0])

    if argCount > 1:
        output is replace;
            output
            "{1}"
