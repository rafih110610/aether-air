    if dm["ok"]:
        def.var: dmChannel
            dynamic
            json_loads;
                dm["body"]
        def.var: sent
            dynamic
            http_post_json;
                "https://discord.com/api/v10" + "/channels/" + dmChannel["id"] + "/messages"
                {"content": content}
                ActiveSession["auth"]
        Give: sent
    Give: dm

