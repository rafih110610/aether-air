def.fun: IsGatewayDispatch(eventPacket:dynamic) -> boolean
    def.var: opcode
        int
        ParseGatewayOpcode;
            eventPacket
    Give: opcode == 0

def.fun: IsGatewayHello(eventPacket:dynamic) -> boolean
    def.var: opcode
        int
        ParseGatewayOpcode;
            eventPacket
    Give: opcode == 10

def.fun: IsGatewayHeartbeatAck(eventPacket:dynamic) -> boolean
    def.var: opcode
        int
        ParseGatewayOpcode;
            eventPacket
    Give: opcode == 11

def.fun: GatewaySetPresence(socketId:int, status:string, afk:boolean) -> dynamic
    def.var: normalizedStatus
        string
        lower;
            status
    if normalizedStatus == "offline":
        normalizedStatus is "invisible"
    if normalizedStatus != "online":
        if normalizedStatus != "idle":
            if normalizedStatus != "dnd":
                if normalizedStatus != "invisible":
                    normalizedStatus is "online"

    def.var: payload
        dynamic
        {"op": 3, "d": {"since": 0, "activities": [], "status": normalizedStatus, "afk": afk}}
    def.var: payloadText
        string
        json_dumps;
            payload
    def.var: result
        dynamic
        ws_send_text;
            socketId
            payloadText
    Give: result

def.fun: GatewaySetPresenceWithActivities(socketId:int, status:string, activities:dynamic, afk:boolean) -> dynamic
    def.var: normalizedStatus
        string
        lower;
            status
    if normalizedStatus == "offline":
        normalizedStatus is "invisible"
    if normalizedStatus != "online":
        if normalizedStatus != "idle":
            if normalizedStatus != "dnd":
                if normalizedStatus != "invisible":
                    normalizedStatus is "online"

    def.var: payload
        dynamic
        {"op": 3, "d": {"since": 0, "activities": activities, "status": normalizedStatus, "afk": afk}}
    def.var: payloadText
        string
        json_dumps;
            payload
    def.var: result
        dynamic
        ws_send_text;
            socketId
            payloadText
    Give: result

