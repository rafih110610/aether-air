            output
            "{9}"
            string(args[9])

    Give: output

def.fun: ReplaceDynamicPlaceholders(value:dynamic, args:dynamic) -> dynamic
    def.var: valueKind
        string
        typeOf;
            value

    if valueKind == "string":
        def.var: replacedText
            string
            ApplyArgPlaceholders;
                value
                args
        Give: replacedText

    if valueKind == "list":
        def.var: updatedList
            dynamic
            []
        Repeat for listItem in value:
            def.var: replacedItem
                dynamic
                ReplaceDynamicPlaceholders;
                    listItem
                    args
            updatedList is append;
                updatedList
                replacedItem
        Give: updatedList

    if valueKind == "dict":
        def.var: updatedDict
            dynamic
            {}
        def.var: dictKeys
            dynamic
            keys;
                value
        Repeat for keyName in dictKeys:
            def.var: replacedValue
                dynamic
                ReplaceDynamicPlaceholders;
                    value[keyName]
                    args
            updatedDict is dict_set;
                updatedDict
                keyName
                replacedValue
        Give: updatedDict

    Give: value

def.fun: BuildCommandResponse(bot:dynamic, payload:dynamic) -> dynamic
    def.var: hasContent
        dynamic
        has_key;
            payload
            "content"
    if not hasContent:
        Give: {"handled": FALSE}
    def.var: hasChannelId
        dynamic
        has_key;
