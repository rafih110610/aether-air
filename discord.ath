def.fun: BuildAllowedMentions(parseEveryone:boolean, parseRoles:boolean, parseUsers:boolean) -> dynamic
    def.var: parse
        dynamic
        []
    if parseEveryone:
        parse is ["everyone"]
    if parseRoles:
        parse is parse + ["roles"]
    if parseUsers:
        parse is parse + ["users"]
    Give: {"parse": parse}

def.fun: ParseGatewayOpcode(eventPacket:dynamic) -> int
    Give: eventPacket["event"]["op"]

def.fun: ParseGatewaySeq(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["s"]

def.fun: ParseGatewayType(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["t"]

def.fun: ParseGatewayData(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["d"]

def.fun: IsGatewayDispatch(eventPacket:dynamic) -> boolean
    def.var: opcode
        int
        discord.ParseGatewayOpcode;
            eventPacket
    Give: opcode == 0

def.fun: IsGatewayHello(eventPacket:dynamic) -> boolean
    def.var: opcode
        int
        discord.ParseGatewayOpcode;
            eventPacket
    Give: opcode == 10

def.fun: IsGatewayHeartbeatAck(eventPacket:dynamic) -> boolean
    def.var: opcode
        int
        discord.ParseGatewayOpcode;
            eventPacket
    Give: opcode == 11

