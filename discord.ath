                    payload
                    "author"
            if hasAuthor:
                def.var: author
                    dynamic
                    payload["author"]
                def.var: authorHasBot
                    dynamic
                    has_key;
                        author
                        "bot"
                if authorHasBot:
                    if author["bot"]:
                        NEXT

            def.var: prefix
                string
                ActiveSession["prefix"]
            def.var: startsWithPrefix
                dynamic
                starts_with;
                    payload["content"]
                    prefix
            if not startsWithPrefix:
                NEXT

            def.var: prefixLen
                int
                len;
