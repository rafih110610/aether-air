#! discord.ath
#! Discord.py-inspired starter module for Aether.

def.var: APIBase
    string
    "https://discord.com/api/v10"

def.var: GatewayBase
    string
    "wss://gateway.discord.gg"

def.fun: IntentsDefault() -> dynamic
    Give: {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": FALSE, "guild_members": FALSE, "guild_presences": FALSE, "typing": FALSE, "reactions": TRUE}

def.fun: IntentsAll() -> dynamic
    Give: {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}

def.fun: IntentsDefaultValue() -> int
    Give: 513

def.fun: IntentsMessageContentValue() -> int
    Give: 33281

def.fun: CreateBot(prefix:string, intents:dynamic) -> dynamic
    Give: {"prefix": prefix, "intents": intents, "token": "", "auth": "", "commands": [], "events": []}

def.fun: WithToken(bot:dynamic, token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    Give: {"prefix": bot["prefix"], "intents": bot["intents"], "token": token, "auth": auth, "commands": bot["commands"], "events": bot["events"]}

def.fun: Login(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    def.var: me
        dynamic
        http_get(APIBase + "/users/@me", auth)
    Give: {"token": token, "auth": auth, "session": me}

def.fun: GatewayInfo(bot:dynamic) -> dynamic
    Give: http_get(APIBase + "/gateway/bot", bot["auth"])

def.fun: GatewayOpen(url:string) -> dynamic
    Give: ws_connect(url + "?v=10&encoding=json")

def.fun: GatewayIdentify(socketId:int, token:string, intents:int) -> dynamic
    def.var: identify
        dynamic
        {"op": 2, "d": {"token": token, "intents": intents, "properties": {"os": "aether", "browser": "aether", "device": "aether"}}}
    Give: ws_send_text(socketId, json_dumps(identify))

def.fun: GatewayHeartbeat(socketId:int, seq:int) -> dynamic
    def.var: heartbeat
        dynamic
        {"op": 1, "d": seq}
    Give: ws_send_text(socketId, json_dumps(heartbeat))

def.fun: GatewayRecv(socketId:int) -> dynamic
    def.var: packet
        dynamic
        ws_recv_text(socketId)
    if packet["ok"]:
        Give: {"ok": TRUE, "socket_id": socketId, "raw": packet["text"], "event": json_loads(packet["text"])}
    Give: packet

def.fun: GatewayClose(socketId:int) -> dynamic
    Give: ws_close(socketId)

def.fun: IsSuccess(result:dynamic) -> boolean
    Give: result["ok"]

def.fun: StatusCode(result:dynamic) -> int
    Give: result["status"]

def.fun: BodyText(result:dynamic) -> string
    Give: result["body"]

def.fun: Command(name:string, description:string) -> dynamic
    Give: {"type": "command", "name": name, "description": description}

def.fun: Event(name:string) -> dynamic
    Give: {"type": "event", "name": name}

def.fun: BuildMessage(channelId:string, content:string) -> dynamic
    Give: {"channel_id": channelId, "content": content, "tts": FALSE}

def.fun: SendMessage(bot:dynamic, channelId:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages"
    def.var: payload
        dynamic
        {"content": content}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: SendRichMessage(bot:dynamic, channelId:string, payload:dynamic) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages"
    Give: http_post_json(route, payload, bot["auth"])

def.fun: SendEmbedMessage(bot:dynamic, channelId:string, embed:dynamic) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages"
    def.var: payload
        dynamic
        {"embeds": [embed]}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: EditMessage(bot:dynamic, channelId:string, messageId:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId
    def.var: payload
        dynamic
        {"content": content}
    Give: http_patch_json(route, payload, bot["auth"])

def.fun: DeleteMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId
    Give: http_delete(route, bot["auth"])

def.fun: TriggerTyping(bot:dynamic, channelId:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/typing"
    Give: http_post_json(route, {}, bot["auth"])

def.fun: AddReaction(bot:dynamic, channelId:string, messageId:string, emoji:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    Give: http_put_json(route, {}, bot["auth"])

def.fun: RemoveOwnReaction(bot:dynamic, channelId:string, messageId:string, emoji:string) -> dynamic
    def.var: route
        string
        APIBase + "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    Give: http_delete(route, bot["auth"])

def.fun: GetMe(bot:dynamic) -> dynamic
    Give: http_get(APIBase + "/users/@me", bot["auth"])

def.fun: GetGuild(bot:dynamic, guildId:string) -> dynamic
    Give: http_get(APIBase + "/guilds/" + guildId, bot["auth"])

def.fun: GetChannel(bot:dynamic, channelId:string) -> dynamic
    Give: http_get(APIBase + "/channels/" + channelId, bot["auth"])

def.fun: GetMessage(bot:dynamic, channelId:string, messageId:string) -> dynamic
    Give: http_get(APIBase + "/channels/" + channelId + "/messages/" + messageId, bot["auth"])

def.fun: CreateDM(bot:dynamic, userId:string) -> dynamic
    Give: http_post_json(APIBase + "/users/@me/channels", {"recipient_id": userId}, bot["auth"])

def.fun: SendDM(bot:dynamic, userId:string, content:string) -> dynamic
    def.var: dm
        dynamic
        CreateDM(bot, userId)
    if dm["ok"]:
        def.var: dmChannel
            dynamic
            json_loads(dm["body"])
        Give: SendMessage(bot, dmChannel["id"], content)
    Give: dm

def.fun: RegisterGlobalSlashCommand(bot:dynamic, appId:string, name:string, description:string) -> dynamic
    def.var: route
        string
        APIBase + "/applications/" + appId + "/commands"
    def.var: payload
        dynamic
        {"name": name, "description": description, "type": 1}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: ReplyInteraction(bot:dynamic, interactionId:string, interactionToken:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/interactions/" + interactionId + "/" + interactionToken + "/callback"
    def.var: payload
        dynamic
        {"type": 4, "data": {"content": content}}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: FollowupInteraction(bot:dynamic, appId:string, interactionToken:string, content:string) -> dynamic
    def.var: route
        string
        APIBase + "/webhooks/" + appId + "/" + interactionToken
    def.var: payload
        dynamic
        {"content": content}
    Give: http_post_json(route, payload, bot["auth"])

def.fun: BuildEmbed(title:string, description:string, color:int) -> dynamic
    Give: {"title": title, "description": description, "color": color}

def.fun: BuildAllowedMentions(parseEveryone:boolean, parseRoles:boolean, parseUsers:boolean) -> dynamic
    def.var: parse
        dynamic
        []
    if parseEveryone:
        make: parse = ["everyone"]
    if parseRoles:
        make: parse = parse + ["roles"]
    if parseUsers:
        make: parse = parse + ["users"]
    Give: {"parse": parse}

def.fun: ParseGatewayOpcode(eventPacket:dynamic) -> int
    Give: eventPacket["event"]["op"]

def.fun: ParseGatewaySeq(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["s"]

def.fun: ParseGatewayType(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["t"]

def.fun: ParseGatewayData(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["d"]

def.fun: IsGatewayDispatch(eventPacket:dynamic) -> boolean
    Give: ParseGatewayOpcode(eventPacket) == 0

def.fun: IsGatewayHello(eventPacket:dynamic) -> boolean
    Give: ParseGatewayOpcode(eventPacket) == 10

def.fun: IsGatewayHeartbeatAck(eventPacket:dynamic) -> boolean
    Give: ParseGatewayOpcode(eventPacket) == 11

def.fun: GatewaySetPresence(socketId:int, status:string, afk:boolean) -> dynamic
    def.var: payload
        dynamic
        {"op": 3, "d": {"since": 0, "activities": [], "status": status, "afk": afk}}
    Give: ws_send_text(socketId, json_dumps(payload))

def.fun: GatewayRequestGuildMembers(socketId:int, guildId:string, query:string, limit:int) -> dynamic
    def.var: payload
        dynamic
        {"op": 8, "d": {"guild_id": guildId, "query": query, "limit": limit}}
    Give: ws_send_text(socketId, json_dumps(payload))

def.fun: SendWebhook(webhookUrl:string, content:string) -> dynamic
    Give: http_post_json(webhookUrl, {"content": content}, "")

def.fun: Mention(userId:string) -> string
    Give: "<@" + userId + ">"

def.fun: Channel(channelId:string) -> string
    Give: "<#" + channelId + ">"

def.fun: Role(roleId:string) -> string
    Give: "<@&" + roleId + ">"

def.fun: Emoji(name:string, emojiId:string) -> string
    Give: "<:" + name + ":" + emojiId + ">"

def.fun: ReadyPayload(botName:string) -> dynamic
    Give: {"status": "ready", "bot": botName, "gateway": GatewayBase}