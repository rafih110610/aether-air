#! Friendly compatibility aliases
def.fun: Client(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    Give: {"prefix": "!", "intents": {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}, "token": token, "auth": auth, "commands": [], "events": []}

def.fun: Bot(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    Give: {"prefix": "!", "intents": {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}, "token": token, "auth": auth, "commands": [], "events": []}

def.fun: UseToken(token:string) -> dynamic
    def.var: authed
        dynamic
        {"prefix": "!", "intents": {"guilds": TRUE, "guild_messages": TRUE, "direct_messages": TRUE, "message_content": TRUE, "guild_members": TRUE, "guild_presences": TRUE, "typing": TRUE, "reactions": TRUE}, "token": token, "auth": "Bot " + token, "commands": [], "events": []}
    ActiveToken is token
    ActiveSession is authed
    Give: authed

def.fun: RunActive() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."

    def.var: info
        dynamic
        http_get;
            "https://discord.com/api/v10" + "/gateway/bot"
            ActiveSession["auth"]
    if not info["ok"]:
        Give: info

    def.var: details
        dynamic
        json_loads;
            info["body"]

    def.var: opened
        dynamic
        ws_connect;
            details["url"] + "?v=10&encoding=json"
    if not opened["ok"]:
        Give: opened

    def.var: sid
        int
        opened["socket_id"]

    def.var: identify
        dynamic
        {"op": 2, "d": {"token": ActiveSession["token"], "intents": ActiveSession["intents"], "properties": {"os": "aether", "browser": "aether", "device": "aether"}}}
    def.var: identifyText
        string
        json_dumps;
            identify
    ws_send_text;
        sid
        identifyText

    def.var: intervalSeconds
        float
        30
    def.var: hello
        dynamic
        ws_recv_text;
            sid
    if hello["ok"]:
        def.var: helloEvent
            dynamic
            json_loads;
                hello["text"]
        def.var: helloPacket
            dynamic
            {"ok": TRUE, "socket_id": sid, "raw": hello["text"], "event": helloEvent}
        if helloPacket["event"]["op"] == 10:
            def.var: helloData
                dynamic
                helloPacket["event"]["d"]
            def.var: heartbeatInterval
                float
                helloData["heartbeat_interval"]
            intervalSeconds is heartbeatInterval / 1000

    Repeat:
        def.var: heartbeatText
            string
            json_dumps;
                {"op": 1, "d": 0}
        ws_send_text;
            sid
            heartbeatText
        time_sleep;
            intervalSeconds

def.fun: Session() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."
    Give: ActiveSession

def.fun: IsSessionReady() -> boolean
    Give: ActiveToken != ""

def.fun: ClearSession() -> dynamic
    ActiveToken is ""
    ActiveSession is {}
    Give: empty

def.fun: SendWith(tokenOrBot:dynamic, channelId:string, content:string) -> dynamic
    def.var: tokenType
        string
        typeOf;
            tokenOrBot
    if tokenType == "string":
        def.var: result
            dynamic
            http_post_json;
                "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
                {"content": content}
                "Bot " + tokenOrBot
        Give: result
    def.var: result
        dynamic
        http_post_json;
            "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
            {"content": content}
            tokenOrBot["auth"]
    Give: result

def.fun: Send(channelId:string, content:string) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."
    def.var: result
        dynamic
        http_post_json;
            "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
            {"content": content}
            ActiveSession["auth"]
    Give: result

