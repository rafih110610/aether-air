def.fun: SendDM(bot:dynamic, userId:string, content:string) -> dynamic
    def.var: dm
        dynamic
        CreateDM;
            bot
            userId
    if dm["ok"]:
        def.var: dmChannel
            dynamic
            json_loads;
                dm["body"]
        def.var: sent
            dynamic
            SendMessage;
                bot
                dmChannel["id"]
                content
        Give: sent
    Give: dm

