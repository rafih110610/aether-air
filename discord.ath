def.fun: PresenceActive() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."

    def.var: status
        string
        ActivePresenceStatus
    def.var: afk
        boolean
        ActivePresenceAfk
    def.var: activities
        dynamic
        ActivePresenceActivities

    def.var: hasStatus
        dynamic
        has_key;
            ActiveSession
            "presence_status"
    if hasStatus:
        status is ActiveSession["presence_status"]

    def.var: hasAfk
        dynamic
        has_key;
            ActiveSession
            "presence_afk"
    if hasAfk:
        afk is ActiveSession["presence_afk"]

    def.var: hasActivities
        dynamic
        has_key;
            ActiveSession
            "presence_activities"
    if hasActivities:
        activities is ActiveSession["presence_activities"]

    Give: {"status": status, "afk": afk, "activities": activities}

