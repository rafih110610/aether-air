    Give: result

def.fun: GatewayOpen(url:string) -> dynamic
    def.var: gatewayUrl
        string
        url
    def.var: endsWithSlash
        dynamic
        ends_with;
            gatewayUrl
            "/"
    if endsWithSlash:
        gatewayUrl is gatewayUrl + "?v=10&encoding=json"
    otherwise:
        gatewayUrl is gatewayUrl + "/?v=10&encoding=json"
    def.var: opened
        dynamic
        ws_connect;
            gatewayUrl
    Give: opened

def.fun: GatewayIdentify(socketId:int, token:string, intents:int) -> dynamic
    def.var: identify
        dynamic
        {"op": 2, "d": {"token": token, "intents": intents, "properties": {"os": "aether", "browser": "aether", "device": "aether"}}}
    def.var: identifyText
        string
        json_dumps;
            identify
    def.var: sendResult
        dynamic
        ws_send_text;
            socketId
            identifyText
    Give: sendResult

def.fun: GatewayHeartbeat(socketId:int, seq:dynamic) -> dynamic
    ActiveHeartbeatSentAt is time_now;
    def.var: heartbeat
        dynamic
        {"op": 1, "d": seq}
    def.var: heartbeatText
        string
        json_dumps;
            heartbeat
    def.var: sendResult
        dynamic
        ws_send_text;
            socketId
            heartbeatText
    Give: sendResult

def.fun: GatewayRecv(socketId:int) -> dynamic
    def.var: packet
        dynamic
        ws_recv_text;
            socketId
    if packet["ok"]:
        def.var: parsedEvent
            dynamic
            json_loads;
                packet["text"]
        Give: {"ok": TRUE, "socket_id": socketId, "raw": packet["text"], "event": parsedEvent}
    Give: packet

