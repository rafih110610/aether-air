                dynamic
                has_key;
                    packet
                    "timeout"
            if packetHasTimeout:
                if packet["timeout"]:
                    NEXT

            if not packet["ok"]:
                ws_close;
                    sid
                STOP

            def.var: event
                dynamic
                {}
            Do:
                event is json_loads;
                    packet["text"]
            Catch as err:
                NEXT

            def.var: eventHasOp
                dynamic
                has_key;
                    event
                    "op"
            if not eventHasOp:
                NEXT

            def.var: eventHasS
                dynamic
                has_key;
                    event
                    "s"
            if eventHasS:
                if event["s"] != empty:
                    seq is event["s"]

            def.var: opcode
                int
                event["op"]

            if opcode == 1:
                def.var: heartbeatSent
                    dynamic
                    GatewayHeartbeat;
                        sid
                        seq
                if not heartbeatSent["ok"]:
                    ws_close;
                        sid
                    STOP
                NEXT

            if opcode == 11:
                if ActiveHeartbeatSentAt > 0:
                    def.var: ackNow
                        float
                        time_now;
                    def.var: elapsedMsFloat
                        float
                        (ackNow - ActiveHeartbeatSentAt) * 1000
                    def.var: elapsedMs
                        int
                        int;
                            elapsedMsFloat
                    if elapsedMs < 0:
                        elapsedMs is 0
                    ActiveGatewayLatencyMs is elapsedMs
                NEXT

            if opcode == 7:
                ws_close;
                    sid
                STOP

            if opcode == 9:
                ws_close;
                    sid
                STOP

            if opcode == 10:
                def.var: eventHasD
                    dynamic
                    has_key;
                        event
                        "d"
                if eventHasD:
                    def.var: helloData
                        dynamic
                        event["d"]
                    def.var: helloDataHasHeartbeat
                        dynamic
                        has_key;
                            helloData
                            "heartbeat_interval"
                    if helloDataHasHeartbeat:
                        heartbeatSeconds is helloData["heartbeat_interval"] / 1000
                        if heartbeatSeconds <= 0:
                            heartbeatSeconds is 30
                        def.var: nextBase
                            float
                            time_now;
                        nextHeartbeat is nextBase + heartbeatSeconds
                NEXT

            if opcode != 0:
                NEXT

            def.var: eventHasT
                dynamic
                has_key;
                    event
                    "t"
            if not eventHasT:
                NEXT

            if event["t"] == "READY":
                ActiveSession is dict_set;
                    ActiveSession
                    "ready"
                    TRUE
                NEXT

            if event["t"] != "MESSAGE_CREATE":
                NEXT

            def.var: messageHasD
                dynamic
                has_key;
                    event
                    "d"
            if not messageHasD:
                NEXT

            def.var: payload
                dynamic
                event["d"]

            Do:
                ProcessMessageCreate;
                    ActiveSession
                    payload
            Catch as err:
                NEXT
            NEXT

            def.var: hasContent
                dynamic
                has_key;
                    payload
                    "content"
            if not hasContent:
                NEXT

            def.var: hasChannelId
                dynamic
                has_key;
                    payload
                    "channel_id"
            if not hasChannelId:
                NEXT

            def.var: hasAuthor
                dynamic
