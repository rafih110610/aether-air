#! =============================================================================
#! discord.ath — The easiest Discord bot library in the world
#! =============================================================================
#!
#! 🚀 SIMPLEST BOT (3 lines):
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   Run bot
#!
#! ⚡ WITH COMMANDS (6 lines):
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   AddCommand bot "ping" "Check latency" handler
#!   On bot "ready" readyHandler
#!   Run bot
#!
#! 🔥 FULL POWER: slash commands, embeds, DMs, reactions, permissions, audit logs
#! =============================================================================

#! ---- constants ----
var API string = "https://discord.com/api/v10"
var GatewayURL string = "wss://gateway.discord.gg/?v=10&encoding=json"

#! ==============================
#! 🔌  REST API (low level)
#! ==============================

fun Get
    path
    token
    give http_get API + path "Bot " + token

fun Post
    path
    token
    body
    give http_post_json API + path body "Bot " + token

fun Put
    path
    token
    body
    give http_put_json API + path body "Bot " + token

fun Patch
    path
    token
    body
    give http_patch_json API + path body "Bot " + token

fun Delete
    path
    token
    give http_delete API + path "Bot " + token

#! ---- message actions ----
fun Send
    token
    channelId
    content
    give Post "/channels/" + channelId + "/messages" token {"content": content}

fun Reply
    token
    channelId
    messageId
    content
    give Post "/channels/" + channelId + "/messages" token {"content": content, "message_reference": {"message_id": messageId}}

fun SendEmbed
    token
    channelId
    embed
    give Post "/channels/" + channelId + "/messages" token {"embeds": [embed]}

fun MakeEmbed
    title
    description
    color
    give {"title": title, "description": description, "color": color}

fun Edit
    token
    channelId
    messageId
    content
    give Patch "/channels/" + channelId + "/messages/" + messageId token {"content": content}

fun DeleteMsg
    token
    channelId
    messageId
    give Delete "/channels/" + channelId + "/messages/" + messageId token

fun React
    token
    channelId
    messageId
    emoji
    give Put "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me" token {}

fun SendDM
    token
    userId
    content
    var ch dynamic = Post "/users/@me/channels" token {"recipient_id": userId}
    give Send token ch.id content

#! ---- moderation ----
fun Kick
    token
    guildId
    userId
    reason
    give Delete "/guilds/" + guildId + "/members/" + userId token {"reason": reason}

fun Ban
    token
    guildId
    userId
    reason
    give Put "/guilds/" + guildId + "/bans/" + userId token {"reason": reason}

fun Unban
    token
    guildId
    userId
    give Delete "/guilds/" + guildId + "/bans/" + userId token {}

fun Timeout
    token
    guildId
    userId
    seconds
    give Patch "/guilds/" + guildId + "/members/" + userId token {"communication_disabled_until": time_now + seconds}

fun AddRole
    token
    guildId
    userId
    roleId
    give Put "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId token {}

fun RemoveRole
    token
    guildId
    userId
    roleId
    give Delete "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId token {}

#! ---- guild & user info ----
fun GetUser
    token
    userId
    give Get "/users/" + userId token

fun GetGuild
    token
    guildId
    give Get "/guilds/" + guildId token

fun GetChannel
    token
    channelId
    give Get "/channels/" + channelId token

#! ---- gateway ----
fun WsConnect
    give ws_connect GatewayURL

fun WsSend
    socketId
    payload
    give ws_send_text socketId payload

fun WsRecv
    socketId
    give ws_recv_text socketId

fun WsRecvTimeout
    socketId
    secs
    give ws_recv_text_timeout socketId secs

fun WsClose
    socketId
    give ws_close socketId

#! ==============================
#! 🤖  BOT ENGINE (mid level)
#! ==============================

fun Identify
    token
    socketId
    var payload dynamic = {"op": 2, "d": {"token": token, "intents": 33281, "properties": {"os": "linux", "browser": "aether", "device": "aether"}}}
    WsSend socketId json_dumps payload

fun SetPresence
    token
    status
    activityName
    activityType
    var socketId int = 0
    var act dynamic = empty
    if activityName != empty
        act is {"name": activityName, "type": activityType}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": status, "afk": false}}

fun HandleDispatch
    bot
    token
    event
    var t string = event.t
    var d dynamic = event.d

    if t == "READY"
        bot.user is d.user
        say "✅ Logged in as: " + d.user.username
        bot._socketId is event._socketId
        CallEvent bot "ready" d

    or t == "MESSAGE_CREATE"
        HandleMessage bot token d

    or t == "INTERACTION_CREATE"
        HandleInteraction bot token d

    or t == "GUILD_CREATE"
        CallEvent bot "guild_join" d

    or t == "GUILD_MEMBER_ADD"
        CallEvent bot "member_join" d

    or t == "GUILD_MEMBER_REMOVE"
        CallEvent bot "member_leave" d

fun HandleMessage
    bot
    token
    msg
    #! skip own messages
    if msg.author.id == bot.user.id
        give empty

    var content string = msg.content
    var prefix string = bot.prefix

    #! check prefix
    if prefix != empty
        if len content >= len prefix
            if content[0 len prefix] == prefix
                var rest string = content[len prefix len content]
                var parts dynamic = split rest " "
                var cmd string = parts[0]
                var args dynamic = {}
                if len parts > 1
                    args is parts[1 len parts]
                RunCommand bot token msg cmd args
                give empty

    #! call user handler
    CallEvent bot "message" msg token

fun HandleInteraction
    bot
    token
    interaction
    var cmdData dynamic = interaction.data
    if cmdData != empty
        var name string = cmdData.name
        var args dynamic = cmdData.options
        var opts dynamic = {}
        if args != empty
            repeat item in args
                opts[item.name] is item.value
        Acknowledge token interaction
        RunCommand bot token interaction name opts

fun Acknowledge
    token
    interaction
    Post "/interactions/" + interaction.id + "/" + interaction.token + "/callback" token {"type": 5}

fun InteractionReply
    token
    interaction
    content
    Post "/interactions/" + interaction.id + "/" + interaction.token + "/callback" token {"type": 4, "data": {"content": content}}

fun InteractionEmbed
    token
    interaction
    embed
    Post "/interactions/" + interaction.id + "/" + interaction.token + "/callback" token {"type": 4, "data": {"embeds": [embed]}}

fun RunCommand
    bot
    token
    source
    cmd
    args
    #! built-ins
    if cmd == "ping"
        ReplyTo token source "🏓 Pong!"
        give empty
    or cmd == "help"
        var cmds string = ""
        var keys dynamic = keys bot.commands
        repeat k in keys
            if cmds != empty
                cmds is cmds + ", "
            cmds is cmds + "`" + k + "`"
        ReplyTo token source "Commands: " + cmds
        give empty

    #! user commands
    var command dynamic = bot.commands[cmd]
    if command != empty
        #! Simple reply command (from puzzles or SimpleCommand)
        var reply dynamic = command.reply
        if reply != empty
            ReplyTo token source reply
            give empty

        #! Handler-based command
        var handler dynamic = command.handler
        if handler != empty
            command.handler bot token source args
            give empty

        ReplyTo token source "Command has no action"
    otherwise
        ReplyTo token source "Unknown: `" + cmd + "`"

fun ReplyTo
    token
    source
    content
    if source.author != empty
        Reply token source.channel_id source.id content
    otherwise
        InteractionReply token source content

fun CallEvent
    bot
    event
    args
    extra
    var handler dynamic = bot.handlers[event]
    if handler != empty
        handler bot args extra

#! ==============================
#! 🎯  QUICKBOT API (high level)
#! ==============================

#! Create a bot — one function call
fun QuickBot
    token
    prefix
    give {"token": token, "prefix": prefix, "commands": {}, "handlers": {}, "user": {}, "_socketId": 0}

#! Add a prefix command
fun AddCommand
    bot
    name
    description
    handler
    bot.commands[name] is {"description": description, "handler": handler}

#! Add an event handler
fun On
    bot
    event
    handler
    bot.handlers[event] is handler

#! Start the bot
fun Run
    bot
    say "🤖 Connecting to Discord..."
    var socketId int = ws_connect GatewayURL
    var info dynamic = json_loads WsRecvTimeout socketId 10
    bot._socketId is socketId

    #! identify
    var intents int = 33281
    var identify dynamic = {"op": 2, "d": {"token": bot.token, "intents": intents, "properties": {"os": "linux", "browser": "aether", "device": "aether"}}}
    WsSend socketId json_dumps identify

    var heartbeatInterval float = 0
    var seq int = 0

    #! main event loop
    say "🤖 Bot running — press Ctrl+C to stop"
    repeat
        var raw string = WsRecvTimeout socketId 60
        var event dynamic = json_loads raw
        var op int = event.op
        seq is event.s

        if op == 0
            var t string = event.t
            var d dynamic = event.d

            if t == "READY"
                bot.user is d.user
                say "✅ Logged in: " + d.user.username
                CallEvent bot "ready" d

            or t == "MESSAGE_CREATE"
                HandleMessage bot bot.token d

            or t == "INTERACTION_CREATE"
                HandleInteraction bot bot.token d

            or t == "GUILD_CREATE"
                CallEvent bot "guild_join" d

            or t == "GUILD_MEMBER_ADD"
                CallEvent bot "member_join" d

        or op == 1
            var hb dynamic = {"op": 1, "d": seq}
            WsSend socketId json_dumps hb

        or op == 7 or op == 9
            say "🔄 Reconnecting..."
            WsClose socketId
            stop

        or op == 10
            heartbeatInterval is event.d.heartbeat_interval / 1000.0

        #! heartbeat
        if heartbeatInterval > 0
            var hbPayload dynamic = {"op": 1, "d": seq}
            WsSend socketId json_dumps hbPayload

#! ==============================
#! 🧩  PUZZLE SYSTEM (cog-like command groups)
#! ==============================
#!
#! Puzzles are like Discord.py cogs — each .ath file in puzzles/
#! is a self-contained module with its own commands and handlers.
#!
#! puzzle "Fun"
#!     command "ping"
#!         reply "🏓 Pong!"
#!     command "greet"
#!         reply "Hello!"
#! end

#! Load all puzzles from a directory
fun LoadPuzzles
    bot
    dir
    say "📦 Loading puzzles from " + dir + "..."
    var files dynamic = os_listdir dir
    if files == empty
        say "   (no puzzle files found)"
        give empty

    repeat file in files
        if len file < 4
            next
        var ext string = file[len file - 4 len file]
        if ext != ".ath"
            next
        var path string = dir + "/" + file
        var name string = file[0 len file - 4]
        say "   🧩 " + name
        LoadPuzzle bot path name

#! Load a single puzzle file
fun LoadPuzzle
    bot
    path
    name
    var source string = file_read_text path
    var lines dynamic = split source "\n"
    ParsePuzzle bot lines name

#! Parse puzzle DSL
fun ParsePuzzle
    bot
    lines
    puzzleName
    var i int = 0
    var total int = len lines
    var currentCmd string = ""
    var currentDesc string = ""
    var currentBody string = ""
    var inCmd int = 0

    repeat
        if i >= total
            break
        var line string = lines[i]
        var trimmed string = trim line
        i is i + 1

        #! skip comments and blanks
        if trimmed == ""
            next
        if len trimmed >= 2
            if trimmed[0 1] == "#!"
                next

        #! puzzle header
        if len trimmed >= 7
            if trimmed[0 6] == "puzzle "
                next

        #! end of puzzle
        if trimmed == "end"
            break

        #! command declaration
        if len trimmed >= 8
            if trimmed[0 7] == "command "
                var rest string = trim trimmed[8 len trimmed]
                var parts dynamic = split rest " "
                if len parts >= 1
                    currentCmd is parts[0]
                    currentDesc is ""
                    if len parts >= 2
                        currentDesc is parts[1 len parts]
                next

        #! reply body
        if len trimmed >= 6
            if trimmed[0 5] == "reply "
                var content string = trim trimmed[6 len trimmed]
                RegisterPuzzleCommand bot puzzleName currentCmd currentDesc content
                next

#! Register a puzzle command (wraps the handler)
fun RegisterPuzzleCommand
    bot
    puzzle
    cmd
    desc
    replyContent
    var fullName string = cmd
    var command dynamic = {"description": desc, "puzzle": puzzle, "reply": replyContent}
    bot.commands[fullName] is command

#! ==============================
#! 🚀  ZERO-BOILERPLATE BOT API
#! ==============================

#! Create a bot from environment — reads DISCORD_TOKEN, DISCORD_PREFIX
fun BotFromEnv
    var token string = os_getenv "DISCORD_TOKEN" ""
    if token == empty
        say "❌ Set DISCORD_TOKEN in .glo or .env"
        process_exit 1
    var prefix string = os_getenv "DISCORD_PREFIX" "!"
    give QuickBot token prefix

#! Run a bot with puzzle auto-loading
fun RunWithPuzzles
    bot
    LoadPuzzles bot "puzzles"
    LoadPuzzles bot "./puzzles"
    Run bot

#! ==============================
#! ✨  CLEANER HELPERS
#! ==============================

#! Shortcut for replying to a message
fun MsgReply
    token
    msg
    content
    Send token msg.channel_id content

#! Get channel from message
fun MsgChannel
    msg
    give msg.channel_id

#! Get author from message
fun MsgAuthor
    msg
    give msg.author

#! Check if message has a prefix
fun MsgHasPrefix
    msg
    prefix
    var content string = msg.content
    if len content < len prefix
        give false
    give content[0 len prefix] == prefix

#! Get command from prefixed message
fun MsgCommand
    msg
    prefix
    var content string = msg.content
    var rest string = content[len prefix len content]
    var parts dynamic = split rest " "
    if len parts == 0
        give ""
    give parts[0]

#! ==============================
#! 📋  COMMAND DEFINITION HELPER
#! ==============================

#! Define a command with a simple reply
fun SimpleCommand
    bot
    name
    desc
    reply
    var cmd dynamic = {"description": desc, "reply": reply}
    bot.commands[name] is cmd
