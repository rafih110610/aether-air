def.fun: DeferInteraction(bot:dynamic, interactionId:string, interactionToken:string, ephemeral:boolean) -> dynamic
    def.var: flags
        int
        0
    if ephemeral:
        flags is 64
    def.var: payload
        dynamic
        {"type": 5, "data": {"flags": flags}}
    def.var: result
        dynamic
        http_post_json;
            APIBase + "/interactions/" + interactionId + "/" + interactionToken + "/callback"
            payload
            bot["auth"]
    Give: result

