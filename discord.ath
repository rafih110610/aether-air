    if tokenType == "string":
        def.var: result
            dynamic
            http_post_json;
                "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
                {"embeds": [embed]}
                "Bot " + tokenOrBot
        Give: result
    def.var: result
        dynamic
        http_post_json;
            "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
            {"embeds": [embed]}
            tokenOrBot["auth"]
    Give: result

