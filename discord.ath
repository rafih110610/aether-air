    Give: result

def.fun: DM(userId:string, content:string) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."
    def.var: dm
        dynamic
        http_post_json;
            "https://discord.com/api/v10" + "/users/@me/channels"
            {"recipient_id": userId}
            ActiveSession["auth"]
    if dm["ok"]:
        def.var: dmChannel
            dynamic
            json_loads;
                dm["body"]
        def.var: sent
            dynamic
            http_post_json;
                "https://discord.com/api/v10" + "/channels/" + dmChannel["id"] + "/messages"
                {"content": content}
                ActiveSession["auth"]
        Give: sent
    Give: dm

def.fun: Verify(token:string) -> dynamic
    def.var: result
        dynamic
        http_get;
            "https://discord.com/api/v10" + "/users/@me"
            "Bot " + token
    Give: result

