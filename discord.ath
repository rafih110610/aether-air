                resolved["args"]
        Give: {"handled": TRUE, "mode": "message", "command": resolved["name"], "channel_id": payload["channel_id"], "content": responseContent, "args": resolved["args"], "raw": resolved["raw"]}

    def.var: resolvedHasAction
        dynamic
        has_key;
            resolved
            "action"
    if resolvedHasAction:
        Give: {"handled": TRUE, "mode": "action", "command": resolved["name"], "channel_id": payload["channel_id"], "action": resolved["action"], "args": resolved["args"], "raw": resolved["raw"], "payload": payload}

    Give: {"handled": FALSE, "reason": "unsupported_command_shape", "command": resolved["name"]}

