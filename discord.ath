def.fun: ParseGatewayOpcode(eventPacket:dynamic) -> int
    Give: eventPacket["event"]["op"]

def.fun: ParseGatewaySeq(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["s"]

def.fun: ParseGatewayType(eventPacket:dynamic) -> dynamic
    Give: eventPacket["event"]["t"]

