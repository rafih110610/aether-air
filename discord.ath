def.fun: ResolveIntentsValue(intents:dynamic) -> int
    def.var: kind
        string
        typeOf;
            intents
    if kind == "int":
        Give: intents
    if kind == "float":
        def.var: castedInt
            int
            int;
                intents
        Give: castedInt
    if kind != "dict":
        def.var: fallbackIntents
            int
            IntentsMessageContentValue;
        Give: fallbackIntents

    def.var: total
        int
        0

    def.var: enabled
        boolean
        FALSE

    def.var: hasGuilds
        dynamic
        has_key;
            intents
            "guilds"
    if hasGuilds:
        if intents["guilds"]:
            total is total + 1

    enabled is FALSE
    def.var: hasMembers
        dynamic
        has_key;
            intents
            "members"
    if hasMembers:
        if intents["members"]:
            enabled is TRUE
    def.var: hasGuildMembers
        dynamic
        has_key;
            intents
            "guild_members"
    if hasGuildMembers:
        if intents["guild_members"]:
            enabled is TRUE
    if enabled:
        total is total + 2

    enabled is FALSE
    def.var: hasBans
        dynamic
        has_key;
            intents
            "bans"
    if hasBans:
        if intents["bans"]:
            enabled is TRUE
    def.var: hasModeration
        dynamic
        has_key;
            intents
            "moderation"
    if hasModeration:
        if intents["moderation"]:
            enabled is TRUE
    if enabled:
        total is total + 4

    enabled is FALSE
    def.var: hasEmojisAndStickers
        dynamic
        has_key;
            intents
            "emojis_and_stickers"
    if hasEmojisAndStickers:
        if intents["emojis_and_stickers"]:
            enabled is TRUE
    def.var: hasEmojis
        dynamic
        has_key;
            intents
            "emojis"
    if hasEmojis:
        if intents["emojis"]:
            enabled is TRUE
    def.var: hasExpressions
        dynamic
        has_key;
            intents
            "expressions"
    if hasExpressions:
        if intents["expressions"]:
            enabled is TRUE
    if enabled:
        total is total + 8

    def.var: hasIntegrations
        dynamic
        has_key;
            intents
            "integrations"
    if hasIntegrations:
        if intents["integrations"]:
            total is total + 16

    def.var: hasWebhooks
        dynamic
        has_key;
            intents
            "webhooks"
    if hasWebhooks:
        if intents["webhooks"]:
            total is total + 32

    def.var: hasInvites
        dynamic
        has_key;
            intents
            "invites"
    if hasInvites:
        if intents["invites"]:
            total is total + 64

    def.var: hasVoiceStates
        dynamic
        has_key;
            intents
            "voice_states"
    if hasVoiceStates:
        if intents["voice_states"]:
            total is total + 128

    enabled is FALSE
    def.var: hasPresences
        dynamic
        has_key;
            intents
            "presences"
    if hasPresences:
        if intents["presences"]:
            enabled is TRUE
    def.var: hasGuildPresences
        dynamic
        has_key;
            intents
            "guild_presences"
    if hasGuildPresences:
        if intents["guild_presences"]:
            enabled is TRUE
    if enabled:
        total is total + 256

    def.var: hasGuildMessages
        dynamic
        has_key;
            intents
            "guild_messages"
    if hasGuildMessages:
        if intents["guild_messages"]:
            total is total + 512

    def.var: hasGuildReactions
        dynamic
        has_key;
            intents
            "guild_reactions"
    if hasGuildReactions:
        if intents["guild_reactions"]:
            total is total + 1024

    def.var: hasGuildTyping
        dynamic
        has_key;
            intents
            "guild_typing"
    if hasGuildTyping:
        if intents["guild_typing"]:
            total is total + 2048

    enabled is FALSE
    def.var: hasDmMessages
        dynamic
        has_key;
            intents
            "dm_messages"
    if hasDmMessages:
        if intents["dm_messages"]:
            enabled is TRUE
    def.var: hasDirectMessages
        dynamic
        has_key;
            intents
            "direct_messages"
    if hasDirectMessages:
        if intents["direct_messages"]:
            enabled is TRUE
    if enabled:
        total is total + 4096

    def.var: hasDmReactions
        dynamic
        has_key;
            intents
            "dm_reactions"
    if hasDmReactions:
        if intents["dm_reactions"]:
            total is total + 8192

    enabled is FALSE
    def.var: hasDmTyping
        dynamic
        has_key;
            intents
            "dm_typing"
    if hasDmTyping:
        if intents["dm_typing"]:
            enabled is TRUE
    def.var: hasTyping
        dynamic
        has_key;
            intents
            "typing"
    if hasTyping:
        if intents["typing"]:
            enabled is TRUE
    if enabled:
        total is total + 16384

    def.var: hasMessageContent
        dynamic
        has_key;
            intents
            "message_content"
    if hasMessageContent:
        if intents["message_content"]:
            total is total + 32768

    def.var: hasGuildScheduledEvents
        dynamic
        has_key;
            intents
            "guild_scheduled_events"
    if hasGuildScheduledEvents:
        if intents["guild_scheduled_events"]:
