def.fun: Run(bot:dynamic) -> dynamic
    def.var: selected
        dynamic
        UseBot;
            bot
    def.var: running
        dynamic
        RunActive;
    Give: running

def.fun: Start(bot:dynamic) -> dynamic
    def.var: running
        dynamic
        Run;
            bot
    Give: running

def.fun: Session() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."
    Give: ActiveSession

def.fun: IsSessionReady() -> boolean
    Give: ActiveToken != ""

def.fun: ClearSession() -> dynamic
    ActiveToken is ""
    ActiveSession is {}
    ActivePresenceStatus is "online"
    ActivePresenceAfk is FALSE
    ActivePresenceActivities is []
    Give: empty

def.fun: SendWith(tokenOrBot:dynamic, channelId:string, content:string) -> dynamic
    def.var: tokenType
        string
        typeOf;
            tokenOrBot
    if tokenType == "string":
        def.var: result
            dynamic
            http_post_json;
                "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
                {"content": content}
                "Bot " + tokenOrBot
        Give: result
    def.var: result
        dynamic
        http_post_json;
            "https://discord.com/api/v10" + "/channels/" + channelId + "/messages"
            {"content": content}
            tokenOrBot["auth"]
    Give: result

