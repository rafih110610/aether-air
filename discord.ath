def.fun: ResolveCommand(bot:dynamic, content:string) -> dynamic
    def.var: prefix
        string
        bot["prefix"]
    def.var: startsWithPrefix
        dynamic
        starts_with;
            content
            prefix
    if not startsWithPrefix:
        Give: {"matched": FALSE}

    def.var: prefixLen
        int
        len;
            prefix
    def.var: sliced
        string
        slice;
            content
            prefixLen
            empty
    def.var: raw
        string
        trim;
            sliced
    if raw == "":
        Give: {"matched": FALSE}

    def.var: parts
        list
        split;
            raw
    def.var: partCount
        int
        len;
            parts
    def.var: commandName
        string
        lower;
            parts[0]
    def.var: args
        dynamic
        []
    if partCount > 1:
        args is slice;
            parts
            1
            empty

    Repeat for cmd in bot["commands"]:
        def.var: cmdNameLower
            string
            lower;
                cmd["name"]
        if cmdNameLower == commandName:
            def.var: hasResponse
                dynamic
                has_key;
                    cmd
                    "response"
            if hasResponse:
                Give: {"matched": TRUE, "name": commandName, "response": cmd["response"], "args": args, "raw": raw}

            def.var: hasAction
                dynamic
                has_key;
                    cmd
                    "action"
            if hasAction:
                Give: {"matched": TRUE, "name": commandName, "action": cmd["action"], "args": args, "raw": raw}

            Give: {"matched": TRUE, "name": commandName, "args": args, "raw": raw}

    Give: {"matched": FALSE, "name": commandName}

def.fun: ApplyArgPlaceholders(template:string, args:dynamic) -> string
