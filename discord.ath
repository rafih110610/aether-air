            def.var: maxCharsRaw
                string
                string;
                    actionSpec["max_chars"]
            maxCharsRaw is ApplyArgPlaceholders;
                maxCharsRaw
                args
            Do:
                def.var: parsedMaxChars
                    int
                    int;
                        maxCharsRaw
                maxChars is parsedMaxChars
            Catch as err:
                maxChars is 1400

        if maxChars <= 0:
            maxChars is 1400

        def.var: label
            string
            "Recent records"
        def.var: hasLabel
            dynamic
            has_key;
                actionSpec
                "label"
        if hasLabel:
            label is actionSpec["label"]
        label is ApplyArgPlaceholders;
            label
            args

        def.var: exists
            dynamic
            os_exists;
                logPath
        if not exists:
            Give: {"ok": TRUE, "result": {"path": logPath, "exists": FALSE}, "ack_content": label + ": no records yet."}

        def.var: logText
            string
            ""
        Do:
            logText is file_read_text;
                logPath
        Catch as err:
            def.var: errText
                string
                string;
                    err
            Give: {"ok": FALSE, "error": "read_file_tail failed: " + errText, "error_user": "I could not read the log file."}

        if logText == "":
            Give: {"ok": TRUE, "result": {"path": logPath, "exists": TRUE}, "ack_content": label + ": no records yet."}

        def.var: logLen
            int
            len;
                logText
        if logLen > maxChars:
            def.var: startIndex
                int
                logLen - maxChars
            logText is slice;
                logText
                startIndex
                empty

        def.var: ackContent
            string
            label + "\n" + logText

        Give: {"ok": TRUE, "result": {"path": logPath, "exists": TRUE}, "ack_content": ackContent}

    if actionType == "api_post":
        def.var: hasRoute
            dynamic
            has_key;
                actionSpec
                "route"
        if not hasRoute:
            Give: {"ok": FALSE, "error": "route missing for api_post"}

        def.var: apiPayload
            dynamic
            {}
        def.var: hasPayload
            dynamic
            has_key;
                actionSpec
                "payload"
        if hasPayload:
            apiPayload is actionSpec["payload"]

        def.var: apiRoute
            string
            ApplyArgPlaceholders;
                actionSpec["route"]
                args

        apiPayload is ReplaceDynamicPlaceholders;
            apiPayload
            args

        def.var: posted
            dynamic
            ApiPost;
                bot
                apiRoute
                apiPayload

        def.var: ack
            string
            "Action sent."
        def.var: specHasAck
            dynamic
            has_key;
                actionSpec
                "ack"
        if specHasAck:
            ack is actionSpec["ack"]

        ack is ApplyArgPlaceholders;
            ack
            args

        Give: {"ok": posted["ok"], "result": posted, "ack_content": ack}

    Give: {"ok": FALSE, "error": "unknown action type: " + actionType}

def.fun: ProcessMessageCreate(bot:dynamic, payload:dynamic) -> dynamic
    ActivePlaceholderContext is {}

    ActivePlaceholderContext is dict_set;
        ActivePlaceholderContext
        "prefix"
        bot["prefix"]

    def.var: payloadHasChannelId
        dynamic
        has_key;
            payload
            "channel_id"
    if payloadHasChannelId:
        ActivePlaceholderContext is dict_set;
            ActivePlaceholderContext
            "channel_id"
            string(payload["channel_id"])

    def.var: payloadHasGuildId
        dynamic
        has_key;
            payload
            "guild_id"
    if payloadHasGuildId:
        ActivePlaceholderContext is dict_set;
            ActivePlaceholderContext
            "guild_id"
            string(payload["guild_id"])

    def.var: payloadHasMessageId
        dynamic
        has_key;
            payload
            "id"
    if payloadHasMessageId:
        ActivePlaceholderContext is dict_set;
            ActivePlaceholderContext
            "message_id"
            string(payload["id"])

    def.var: payloadHasAuthor
        dynamic
        has_key;
            payload
            "author"
    if payloadHasAuthor:
        def.var: sourceAuthor
            dynamic
            payload["author"]
        def.var: authorHasId
            dynamic
            has_key;
                sourceAuthor
                "id"
        if authorHasId:
            ActivePlaceholderContext is dict_set;
                ActivePlaceholderContext
                "author_id"
                string(sourceAuthor["id"])

    def.var: action
        dynamic
        BuildCommandResponse;
            bot
            payload

    if not action["handled"]:
        Give: action

    def.var: actionMode
        string
        "message"
    def.var: actionHasMode
        dynamic
        has_key;
            action
            "mode"
    if actionHasMode:
        actionMode is action["mode"]

    if actionMode == "action":
        def.var: executed
            dynamic
            ExecuteCommandAction;
                bot
                action

        if not executed["ok"]:
            def.var: errorContent
                string
                "Command failed."
            def.var: hasErrorUser
                dynamic
                has_key;
                    executed
                    "error_user"
            if hasErrorUser:
                errorContent is executed["error_user"]
            otherwise:
                def.var: hasError
                    dynamic
                    has_key;
                        executed
                        "error"
                if hasError:
                    def.var: errorText
                        string
                        string;
                            executed["error"]
                    errorContent is "Command failed: " + errorText

            def.var: failureSent
                dynamic
                SendMessage;
                    bot
                    action["channel_id"]
                    errorContent

            Give: {"handled": TRUE, "command": action["command"], "mode": "action", "ok": FALSE, "detail": executed, "error_send": failureSent}

        def.var: auditSent
            dynamic
            {}
        def.var: hasAuditChannel
            dynamic
            has_key;
                action["action"]
                "audit_channel_id"
        if hasAuditChannel:
            def.var: auditChannelId
                string
                string;
                    action["action"]["audit_channel_id"]
            auditChannelId is ApplyArgPlaceholders;
                auditChannelId
                action["args"]

            if auditChannelId != "":
                def.var: auditMessage
                    string
                    "Audit | command=" + action["command"]
                def.var: hasAuditMessage
                    dynamic
                    has_key;
                        action["action"]
                        "audit_message"
                if hasAuditMessage:
                    auditMessage is action["action"]["audit_message"]

                auditMessage is ApplyArgPlaceholders;
                    auditMessage
                    action["args"]

                def.var: actorSuffix
                    string
                    ""
                def.var: actionHasPayload
                    dynamic
                    has_key;
                        action
                        "payload"
                if actionHasPayload:
                    def.var: sourcePayload
                        dynamic
                        action["payload"]
                    def.var: payloadHasAuthor
                        dynamic
                        has_key;
                            sourcePayload
                            "author"
                    if payloadHasAuthor:
                        def.var: sourceAuthor
                            dynamic
                            sourcePayload["author"]
                        def.var: authorHasId
                            dynamic
                            has_key;
                                sourceAuthor
                                "id"
                        if authorHasId:
                            def.var: actorId
                                string
                                string;
                                    sourceAuthor["id"]
                            actorSuffix is " | actor=" + actorId

                auditMessage is auditMessage + actorSuffix

                auditSent is SendMessage;
                    bot
                    auditChannelId
                    auditMessage

        def.var: hasAckContent
            dynamic
            has_key;
                executed
                "ack_content"
        if hasAckContent:
            if executed["ack_content"] != "":
                def.var: ackSent
                    dynamic
                    SendMessage;
                        bot
                        action["channel_id"]
                        executed["ack_content"]
                Give: {"handled": TRUE, "command": action["command"], "mode": "action", "ok": TRUE, "result": executed["result"], "ack_send": ackSent, "audit_send": auditSent}

        Give: {"handled": TRUE, "command": action["command"], "mode": "action", "ok": TRUE, "result": executed["result"], "audit_send": auditSent}

    if actionMode != "message":
        Give: {"handled": FALSE, "reason": "unsupported_action_mode", "mode": actionMode}

    def.var: sent
        dynamic
        SendMessage;
            bot
            action["channel_id"]
            action["content"]
    Give: {"handled": TRUE, "command": action["command"], "send": sent}

def.fun: OpenGatewaySession(bot:dynamic) -> dynamic
    def.var: info
        dynamic
        GatewayInfo;
            bot
    if not info["ok"]:
        def.var: infoHasStatus
            dynamic
            has_key;
                info
                "status"
        if infoHasStatus:
            if info["status"] == 401:
                Give: {"ok": FALSE, "stage": "gateway_info", "fatal": TRUE, "error": "unauthorized", "detail": info}
        Give: info

    def.var: details
        dynamic
        json_loads;
            info["body"]
    def.var: detailsHasUrl
        dynamic
        has_key;
            details
            "url"
    if not detailsHasUrl:
        Give: {"ok": FALSE, "stage": "gateway_info", "error": "gateway url missing"}

    def.var: opened
        dynamic
        GatewayOpen;
            details["url"]
    if not opened["ok"]:
        Give: opened

    def.var: sid
        int
        opened["socket_id"]

    def.var: hello
        dynamic
        {}
    Do:
        hello is ws_recv_text_timeout;
            sid
            10
    Catch as err:
        GatewayClose;
            sid
        Give: {"ok": FALSE, "stage": "hello_recv", "error": err}

    if not hello["ok"]:
        GatewayClose;
            sid
        Give: {"ok": FALSE, "stage": "hello", "detail": hello}

    def.var: helloEvent
        dynamic
        {}
    Do:
        helloEvent is json_loads;
            hello["text"]
    Catch as err:
        GatewayClose;
            sid
        Give: {"ok": FALSE, "stage": "hello_parse", "error": err}

    def.var: heartbeatSeconds
        float
        30
    if helloEvent["op"] == 10:
        def.var: helloData
            dynamic
            helloEvent["d"]
        def.var: helloHasHeartbeat
            dynamic
            has_key;
                helloData
                "heartbeat_interval"
        if helloHasHeartbeat:
            heartbeatSeconds is helloData["heartbeat_interval"] / 1000

    if heartbeatSeconds <= 0:
        heartbeatSeconds is 30

    def.var: intentsValue
        int
        ResolveIntentsValue;
            bot["intents"]
    def.var: botHasIntentsValue
        dynamic
        has_key;
            bot
            "intents_value"
    if botHasIntentsValue:
        def.var: resolvedIntentsValue
            int
            int;
                bot["intents_value"]
        intentsValue is resolvedIntentsValue

    def.var: identified
        dynamic
        GatewayIdentify;
            sid
            bot["token"]
            intentsValue
    if not identified["ok"]:
        GatewayClose;
            sid
        Give: {"ok": FALSE, "stage": "identify", "detail": identified}

    def.var: hasPresenceStatus
        dynamic
        has_key;
            bot
            "presence_status"
    def.var: hasPresenceAfk
        dynamic
        has_key;
            bot
            "presence_afk"
    def.var: hasPresenceActivities
        dynamic
        has_key;
            bot
            "presence_activities"
    if hasPresenceStatus:
        if hasPresenceAfk:
            if hasPresenceActivities:
                GatewaySetPresenceWithActivities;
                    sid
                    bot["presence_status"]
                    bot["presence_activities"]
                    bot["presence_afk"]

    Give: {"ok": TRUE, "socket_id": sid, "heartbeat_seconds": heartbeatSeconds}

def.fun: RunActive() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."
    if ActiveToken == "YOUR_BOT_TOKEN":
        flag: "Active token is still placeholder text. Replace YOUR_BOT_TOKEN before running."

    def.var: reconnectDelay
        float
        1

    Repeat:
        def.var: opened
            dynamic
            OpenGatewaySession;
                ActiveSession
        if not opened["ok"]:
            def.var: openedHasFatal
                dynamic
                has_key;
                    opened
                    "fatal"
            if openedHasFatal:
                if opened["fatal"]:
                    flag: "Discord gateway authorization failed (401). Check bot token and bot permissions."
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

        reconnectDelay is 1

        def.var: sid
            int
            opened["socket_id"]
        ActiveSession is dict_set;
            ActiveSession
            "socket_id"
            sid
        def.var: heartbeatSeconds
            float
            opened["heartbeat_seconds"]
        ActiveGatewayLatencyMs is -1
        def.var: seq
            dynamic
            empty
        def.var: nextHeartbeat
            float
            time_now;

        nextHeartbeat is nextHeartbeat + heartbeatSeconds

        Repeat:
            def.var: now
                float
                time_now;
            if now >= nextHeartbeat:
                GatewayHeartbeat;
                    sid
                    seq
                nextHeartbeat is now + heartbeatSeconds

            def.var: packet
                dynamic
                {"ok": FALSE}
            Do:
                packet is ws_recv_text_timeout;
                    sid
                    0.25
            Catch as err:
                packet is {"ok": FALSE, "error": err}

            def.var: packetHasTimeout
                dynamic
                has_key;
                    packet
                    "timeout"
            if packetHasTimeout:
                if packet["timeout"]:
                    NEXT

            if not packet["ok"]:
                GatewayClose;
                    sid
                STOP

            def.var: event
                dynamic
                {}
            Do:
                event is json_loads;
                    packet["text"]
            Catch as err:
                NEXT

            def.var: eventHasOp
                dynamic
                has_key;
                    event
                    "op"
            if not eventHasOp:
                NEXT

            def.var: eventHasS
                dynamic
                has_key;
                    event
                    "s"
            if eventHasS:
                if event["s"] != empty:
                    seq is event["s"]

            def.var: opcode
                int
                event["op"]

            if opcode == 1:
                GatewayHeartbeat;
                    sid
                    seq
                NEXT

            if opcode == 11:
                if ActiveHeartbeatSentAt > 0:
                    def.var: ackNow
                        float
                        time_now;
                    def.var: elapsedMsFloat
                        float
                        (ackNow - ActiveHeartbeatSentAt) * 1000
                    def.var: elapsedMs
                        int
                        int;
                            elapsedMsFloat
                    if elapsedMs < 0:
                        elapsedMs is 0
                    ActiveGatewayLatencyMs is elapsedMs
                NEXT

            if opcode == 7:
                GatewayClose;
                    sid
                STOP

            if opcode == 9:
                GatewayClose;
                    sid
                STOP

            if opcode == 10:
                def.var: eventHasD
                    dynamic
                    has_key;
                        event
                        "d"
                if eventHasD:
                    def.var: helloData
                        dynamic
                        event["d"]
                    def.var: helloDataHasHeartbeat
                        dynamic
                        has_key;
                            helloData
                            "heartbeat_interval"
                    if helloDataHasHeartbeat:
                        heartbeatSeconds is helloData["heartbeat_interval"] / 1000
                        if heartbeatSeconds <= 0:
                            heartbeatSeconds is 30
                        def.var: nextBase
                            float
                            time_now;
                        nextHeartbeat is nextBase + heartbeatSeconds
                NEXT

            if opcode == 0:
                def.var: eventHasT
                    dynamic
                    has_key;
                        event
                        "t"
                if eventHasT:
                    if event["t"] == "READY":
                        ActiveSession is dict_set;
                            ActiveSession
                            "ready"
                            TRUE

                    if event["t"] == "MESSAGE_CREATE":
                        def.var: messageHasD
                            dynamic
                            has_key;
                                event
                                "d"
                        if messageHasD:
                            Do:
                                ProcessMessageCreate;
                                    ActiveSession
                                    event["d"]
                            Catch as err:
                                NEXT

                NEXT

        time_sleep;
            reconnectDelay
        if reconnectDelay < 30:
            reconnectDelay is reconnectDelay * 2
            if reconnectDelay > 30:
                reconnectDelay is 30

def.fun: RunSimpleActive() -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."
    if ActiveToken == "YOUR_BOT_TOKEN":
        flag: "Active token is still placeholder text. Replace YOUR_BOT_TOKEN before running."

    def.var: reconnectDelay
        float
        1

    Repeat:
        def.var: info
            dynamic
            http_get;
                APIBase + "/gateway/bot"
                ActiveSession["auth"]
        if not info["ok"]:
            def.var: infoHasStatus
                dynamic
                has_key;
                    info
                    "status"
            if infoHasStatus:
                if info["status"] == 401:
                    flag: "Discord gateway authorization failed (401). Check bot token and bot permissions."
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

