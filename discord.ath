    Give: ApiGet(bot, "/guilds/" + guildId + "/invites")

def.fun: DeleteInvite(bot:dynamic, inviteCode:string) -> dynamic
    Give: ApiDelete(bot, "/invites/" + inviteCode)

def.fun: RegisterGuildSlashCommand(bot:dynamic, appId:string, guildId:string, name:string, description:string) -> dynamic
    def.var: payload
        dynamic
        {"name": name, "description": description, "type": 1}
    Give: ApiPost(bot, "/applications/" + appId + "/guilds/" + guildId + "/commands", payload)

