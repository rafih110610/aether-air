            {"ok": FALSE}
        Do:
            hello is ws_recv_text_timeout;
                sid
                10
        Catch as err:
            ws_close;
                sid
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

        if not hello["ok"]:
            ws_close;
                sid
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

        def.var: helloEvent
            dynamic
            {}
        Do:
            helloEvent is json_loads;
                hello["text"]
        Catch as err:
            ws_close;
                sid
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

        def.var: heartbeatSeconds
            float
            30
        def.var: helloHasOp
            dynamic
            has_key;
                helloEvent
                "op"
        if helloHasOp:
            if helloEvent["op"] == 10:
                def.var: helloHasD
                    dynamic
                    has_key;
                        helloEvent
                        "d"
                if helloHasD:
                    def.var: helloData
                        dynamic
                        helloEvent["d"]
                    def.var: helloDataHasHeartbeat
                        dynamic
                        has_key;
                            helloData
                            "heartbeat_interval"
                    if helloDataHasHeartbeat:
                        heartbeatSeconds is helloData["heartbeat_interval"] / 1000

        if heartbeatSeconds <= 0:
            heartbeatSeconds is 30

        def.var: intentsValue
            int
            33281
        def.var: hasIntentsValue
            dynamic
            has_key;
                ActiveSession
                "intents_value"
        if hasIntentsValue:
            def.var: parsedIntentsValue
                int
                int;
                    ActiveSession["intents_value"]
            intentsValue is parsedIntentsValue

        def.var: identify
            dynamic
            {"op": 2, "d": {"token": ActiveSession["token"], "intents": intentsValue, "properties": {"os": "aether", "browser": "aether", "device": "aether"}}}
        def.var: identifyText
            string
            json_dumps;
                identify
        def.var: identified
            dynamic
            ws_send_text;
                sid
                identifyText
        if not identified["ok"]:
            ws_close;
                sid
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

        def.var: appliedPresence
            dynamic
            ApplyPresenceActive;
                sid
        if not appliedPresence["ok"]:
            ws_close;
                sid
            time_sleep;
                reconnectDelay
            if reconnectDelay < 30:
                reconnectDelay is reconnectDelay * 2
                if reconnectDelay > 30:
                    reconnectDelay is 30
            NEXT

        def.var: seq
            dynamic
            empty
        ActiveGatewayLatencyMs is -1
        def.var: nextHeartbeat
            float
            time_now;
        nextHeartbeat is nextHeartbeat + heartbeatSeconds

        Repeat:
            def.var: now
                float
                time_now;
            if now >= nextHeartbeat:
                def.var: heartbeatSent
                    dynamic
                    GatewayHeartbeat;
                        sid
                        seq
                if not heartbeatSent["ok"]:
                    ws_close;
                        sid
                    STOP
                nextHeartbeat is now + heartbeatSeconds

            def.var: packet
                dynamic
                {"ok": FALSE}
            Do:
                packet is ws_recv_text_timeout;
                    sid
                    0.25
            Catch as err:
                packet is {"ok": FALSE, "error": err}

