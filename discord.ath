#! =============================================================================
#! discord.ath — Discord.py for Aether (easier wording, same power)
#! =============================================================================
#!
#! 🚀 3-line bot:
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   Run bot
#!
#! ⚡ With commands:
#!   get QuickBot from discord
#!   var bot dynamic = QuickBot "TOKEN" "!"
#!   AddCommand bot "ping" "Check latency" handler
#!   Run bot
#!
#! 🔥 Full discord.py power — embeds, buttons, slash commands, DMs, permissions
#!
#! 📖 discord.py users: ctx is your friend!
#!   fun greet
#!       ctx        # ← context: author, channel, guild, token, source
#!       args
#!       CtxSend ctx "Hello!"
#!       CtxReply ctx "Welcome!"
#! =============================================================================

#! ---- constants ----
var API string = "https://discord.com/api/v10"
var GatewayURL string = "wss://gateway.discord.gg/?v=10&encoding=json"

#! ==============================
#! 🔌  REST API (low level)
#! ==============================

fun Get
    path
    token
    var url string = API + path
    var auth string = "Bot " + token
    give http_get url auth

fun Post
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_post_json url body auth

fun Put
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_put_json url body auth

fun Patch
    path
    token
    body
    var url string = API + path
    var auth string = "Bot " + token
    give http_patch_json url body auth

fun Delete
    path
    token
    var url string = API + path
    var auth string = "Bot " + token
    give http_delete url auth

#! ---- message actions ----
fun Send
    token
    channelId
    content
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content}

fun Reply
    token
    channelId
    messageId
    content
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"content": content, "message_reference": {"message_id": messageId}}

fun SendEmbed
    token
    channelId
    embed
    var path string = "/channels/" + channelId + "/messages"
    give Post path token {"embeds": [embed]}

fun MakeEmbed
    title
    description
    color
    give {"title": title, "description": description, "color": color}

fun Edit
    token
    channelId
    messageId
    content
    var path string = "/channels/" + channelId + "/messages/" + messageId
    give Patch path token {"content": content}

fun DeleteMsg
    token
    channelId
    messageId
    var path string = "/channels/" + channelId + "/messages/" + messageId
    give Delete path token

fun React
    token
    channelId
    messageId
    emoji
    var path string = "/channels/" + channelId + "/messages/" + messageId + "/reactions/" + emoji + "/@me"
    give Put path token {}

fun SendDM
    token
    userId
    content
    var ch dynamic = Post "/users/@me/channels" token {"recipient_id": userId}
    give Send token ch.id content

#! ---- moderation ----
fun Kick
    token
    guildId
    userId
    reason
    give Delete "/guilds/" + guildId + "/members/" + userId token {"reason": reason}

fun Ban
    token
    guildId
    userId
    reason
    give Put "/guilds/" + guildId + "/bans/" + userId token {"reason": reason}

fun Unban
    token
    guildId
    userId
    give Delete "/guilds/" + guildId + "/bans/" + userId token {}

fun Timeout
    token
    guildId
    userId
    seconds
    give Patch "/guilds/" + guildId + "/members/" + userId token {"communication_disabled_until": time_now + seconds}

fun AddRole
    token
    guildId
    userId
    roleId
    give Put "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId token {}

fun RemoveRole
    token
    guildId
    userId
    roleId
    give Delete "/guilds/" + guildId + "/members/" + userId + "/roles/" + roleId token {}

#! ---- guild & user info ----
fun GetUser
    token
    userId
    give Get "/users/" + userId token

fun GetGuild
    token
    guildId
    give Get "/guilds/" + guildId token

fun GetChannel
    token
    channelId
    give Get "/channels/" + channelId token

#! ---- gateway ----
fun WsConnect
    give ws_connect GatewayURL

fun WsSend
    socketId
    payload
    give ws_send_text socketId payload

fun WsRecv
    socketId
    give ws_recv_text socketId

fun WsRecvTimeout
    socketId
    secs
    give ws_recv_text_timeout socketId secs

fun WsClose
    socketId
    give ws_close socketId

#! ==============================
#! 🤖  BOT ENGINE (mid level)
#! ==============================

fun Identify
    token
    socketId
    var payload dynamic = {"op": 2, "d": {"token": token, "intents": 33281, "properties": {"os": "linux", "browser": "aether", "device": "aether"}}}
    var payloadStr string = json_dumps payload
    WsSend socketId payloadStr

fun SetPresence
    token
    status
    activityName
    activityType
    var socketId int = 0
    var act dynamic = empty
    if activityName != empty
        act is {"name": activityName, "type": activityType}
    var payload dynamic = {"op": 3, "d": {"since": empty, "activities": [act], "status": status, "afk": false}}

fun HandleDispatch
    bot
    token
    event
    var t string = event.t
    var d dynamic = event.d

    if t == "READY"
        bot.user is d.user
        say "✅ Logged in as: " + d.user.username
        bot._socketId is event._socketId
        CallEvent bot "ready" d

    or t == "MESSAGE_CREATE"
        HandleMessage bot token d

    or t == "INTERACTION_CREATE"
        HandleInteraction bot token d

    or t == "GUILD_CREATE"
        CallEvent bot "guild_join" d

    or t == "GUILD_MEMBER_ADD"
        CallEvent bot "member_join" d

    or t == "GUILD_MEMBER_REMOVE"
        CallEvent bot "member_leave" d

fun HandleMessage
    bot
    token
    msg
    #! skip own messages
    if msg.author.id == bot.user.id
        give empty

    var content string = msg.content
    var prefix string = bot.prefix

    #! check prefix
    if prefix != empty
        if len(content) >= len(prefix)
            if content[:len(prefix)] == prefix
                var rest string = content[len(prefix):]
                var parts dynamic = split rest " "
                var cmd string = parts[0]
                var args dynamic = {}
                if len(parts) > 1
                    args is parts[1:]
                RunCommand bot token msg cmd args
                give empty

    #! call user handler
    CallEvent bot "message" msg

fun HandleInteraction
    bot
    token
    interaction
    var cmdData dynamic = interaction.data
    if cmdData == empty
        give empty
    var hasName dynamic = has_key cmdData "name"
    var hasCustom dynamic = has_key cmdData "custom_id"

    #! ---- dispatch ALL custom_id interactions to user code ----
    if hasCustom
        CallEvent bot "interaction" interaction
        give empty

    #! ---- handle unknown interactions (no name) ----
    if not hasName
        Acknowledge token interaction
        give empty

    #! ---- slash commands ----
    var name string = cmdData.name
    var args dynamic = cmdData.options
    var opts dynamic = {}
    if args != empty
        repeat item in args
            opts[item.name] is item.value
    Acknowledge token interaction
    RunCommand bot token interaction name opts

fun Acknowledge
    token
    interaction
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 5}

fun InteractionReply
    token
    interaction
    content
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"content": content}}

#! Send an ephemeral (blue, user-only) reply to an interaction
fun InteractionEphemeral
    token
    interaction
    content
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"content": content, "flags": 64}}

#! Defer an interaction (show loading, then send followup later)
fun InteractionDefer
    token
    interaction
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 5}

#! Edit the original interaction response (followup via webhook)
fun InteractionEdit
    token
    interaction
    content
    var path string = "/webhooks/" + interaction.application_id + "/" + interaction.token + "/messages/@original"
    Patch path token {"content": content}

fun InteractionEmbed
    token
    interaction
    embed
    var path string = "/interactions/" + interaction.id + "/" + interaction.token + "/callback"
    Post path token {"type": 4, "data": {"embeds": [embed]}}

fun RunCommand
    bot
    token
    source
    cmd
    args
    #! built-ins
    if cmd == "ping"
        var start float = time_perf_counter
        var pingUrl string = API + "/users/@me"
        var pingAuth string = "Bot " + token
        http_get pingUrl pingAuth
        var end float = time_perf_counter
        var ms int = (end - start) * 1000.0
        ReplyTo token source "Pong! (" + ms + "ms)"
        give empty
    or cmd == "help"
        var cmds string = ""
        var keys dynamic = keys bot.commands
        repeat k in keys
            if cmds != empty
                cmds is cmds + ", "
            cmds is cmds + "`" + k + "`"
        var helpMsg string = "Commands: " + cmds
        ReplyTo token source helpMsg
        give empty

    #! user commands
    var command dynamic = bot.commands[cmd]
    if command != empty
        #! Simple reply command (from puzzles or SimpleCommand)
        var reply dynamic = command.reply
        if reply != empty
            ReplyTo token source reply
            give empty

        #! Handler-based command (string handler name → dispatch via event)
        var handlerName dynamic = command.handler_name
        if handlerName != empty
            CallEvent bot "command" {"cmd": cmd, "token": token, "source": source, "args": args, "handler_name": handlerName}
            give empty

        ReplyTo token source "Command has no action"
    otherwise
        var unknownMsg string = "Unknown: `" + cmd + "`"
        ReplyTo token source unknownMsg

fun ReplyTo
    token
    source
    content
    if source.author != empty
        Reply token source.channel_id source.id content
    otherwise
        InteractionReply token source content

fun CallEvent
    bot
    event
    args
    var extra string = ""
    var handlers dynamic = bot.handlers
    var keysList dynamic = keys handlers
    var found string = ""
    repeat k in keysList
        if k == event
            found is handlers[k]
    if found != empty and found != ""
        call_func found bot args extra

#! ==============================
#! 🎯  QUICKBOT API (high level)
#! ==============================

#! Create a bot — one function call
fun QuickBot
    token
    prefix
    give {"token": token, "prefix": prefix, "commands": {}, "handlers": {}, "user": {}, "_socketId": 0}

#! Add a prefix command (handler = function reference — limited support)
fun AddCommand
    bot
    name
    description
    handler
    var _cmds4 dynamic = bot.commands
    _cmds4[name] is {"description": description, "handler": handler}
    bot.commands is _cmds4
    give bot

#! Add a handler-based command (handler_name = string function name)
#! The handler function must be imported into the module that receives
#! the "command" event. Use with RegisterCog or directly.
fun BotHandler
    bot
    name
    desc
    handlerName
    var _cmds5 dynamic = bot.commands
    _cmds5[name] is {"description": desc, "handler_name": handlerName}
    bot.commands is _cmds5
    give bot

#! Add an event handler
fun On
    bot
    event
    handler
    var _handlers2 dynamic = bot.handlers
    _handlers2[event] is handler
    bot.handlers is _handlers2
    give bot

#! Start the bot
fun Run
    bot
    say "🤖 Connecting to Discord..."
    var conn dynamic = ws_connect GatewayURL
    var socketId int = conn.socket_id
    var infoResp dynamic = WsRecvTimeout socketId 10
    if infoResp.ok != true
        say "   ⏱️ Timeout waiting for Gateway hello"
        give empty
    var infoText string = infoResp.text
    var info dynamic = json_loads infoText
    bot._socketId is socketId

    #! identify
    var intents int = 33281
    var identify dynamic = {"op": 2, "d": {"token": bot.token, "intents": intents, "properties": {"os": "linux", "browser": "aether", "device": "aether"}}}
    var identifyStr string = json_dumps identify
    WsSend socketId identifyStr

    var heartbeatInterval float = 0
    var seq int = 0

    #! main event loop
    say "🤖 Bot running — press Ctrl+C to stop"
    repeat
        var resp dynamic = WsRecvTimeout socketId 60
        if resp.ok != true
            next
        var raw string = resp.text
        if raw == empty
            next
        var event dynamic = json_loads raw
        var op int = event.op
        seq is event.s

        if op == 0
            do:
                var t string = event.t
                var d dynamic = event.d

                if t == "READY"
                    bot.user is d.user
                    say "✅ Logged in: " + d.user.username
                    CallEvent bot "ready" d

                or t == "MESSAGE_CREATE"
                    HandleMessage bot bot.token d

                or t == "INTERACTION_CREATE"
                    HandleInteraction bot bot.token d

                or t == "GUILD_CREATE"
                    CallEvent bot "guild_join" d

                or t == "GUILD_MEMBER_ADD"
                    CallEvent bot "member_join" d

            catch as err:
                say "   ⚠️ Event error (non-fatal): " + err
        or op == 1
            var hb dynamic = {"op": 1, "d": seq}
            var hbStr string = json_dumps hb
            WsSend socketId hbStr

        or op == 7 or op == 9
            say "🔄 Reconnecting..."
            WsClose socketId
            stop

        or op == 10
            heartbeatInterval is event.d.heartbeat_interval / 1000.0

        #! heartbeat
        if heartbeatInterval > 0
            var hbPayload dynamic = {"op": 1, "d": seq}
            var hbPayloadStr string = json_dumps hbPayload
            WsSend socketId hbPayloadStr

#! ==============================
#! 🧩  PUZZLE SYSTEM (cog-like command groups)
#! ==============================
#!
#! Puzzles are like Discord.py cogs — each .ath file in puzzles/
#! is a self-contained module with its own commands and handlers.
#!
#! puzzle "Fun"
#!     command "ping"
#!         reply "🏓 Pong!"
#!     command "greet"
#!         reply "Hello!"
#! end

#! Load all puzzles from a directory
fun LoadPuzzles
    bot
    dir
    say "Loading puzzles from " + dir + "..."
    var files dynamic = os_list_dir dir
    if files == empty
        say "   (no puzzle files found)"
        give empty

    repeat file in files
        var fileLen int = len(file)
        if fileLen < 4
            next
        var ext string = file[fileLen - 4:fileLen]
        if ext != ".ath"
            next
        var path string = dir + "/" + file
        var name string = file[0:fileLen - 4]
        say "   🧩 " + name
        LoadPuzzle bot path name

#! Load a single puzzle file
fun LoadPuzzle
    bot
    path
    name
    var source string = file_read_text path
    var lines dynamic = split source "\n"
    ParsePuzzle bot lines name

#! Parse puzzle DSL
fun ParsePuzzle
    bot
    lines
    puzzleName
    var i int = 0
    var total int = len(lines)
    var currentCmd string = ""
    var currentDesc string = ""
    var currentBody string = ""
    var inCmd int = 0

    repeat
        if i >= total
            break
        var line string = lines[i]
        var trimmed string = trim line
        i is i + 1

        #! skip comments and blanks
        if trimmed == ""
            next
        if len(trimmed) >= 2
            if trimmed[:2] == "#!"
                next

        #! puzzle header
        if len(trimmed) >= 7
            if trimmed[:7] == "puzzle "
                next

        #! end of puzzle
        if trimmed == "end"
            break

        #! command declaration — supports two formats:
        #!   command "name" "desc" "reply"       (one-line, all in one)
        #!   command "name" "desc"               (multi-line, followed by reply block)
        #!   name "desc" "reply"                 (shorthand, no command keyword)
        var isCmd int = 0
        var rawRest string = ""
        if len(trimmed) >= 8
            if trimmed[:8] == "command "
                isCmd is 1
                rawRest is trim trimmed[8:]
        if not isCmd and trimmed[:1] == "\""
            isCmd is 1
            rawRest is trimmed
        if isCmd
            var parts dynamic = split rawRest " "
            if len(parts) >= 1
                var rawName string = parts[0]
                var nameLen int = len(rawName)
                if nameLen >= 2
                    if rawName[:1] == "\""
                        rawName is rawName[1:nameLen - 1]
                currentCmd is rawName
                currentDesc is ""
                if len(parts) >= 2
                    currentDesc is parts[1:]
                #! one-liner: third part is the reply text
                if len(parts) >= 3
                    var rawReply string = parts[2]
                    var replyLen int = len(rawReply)
                    if replyLen >= 2
                        if rawReply[:1] == "\""
                            rawReply is rawReply[1:replyLen - 1]
                    RegisterPuzzleCommand bot puzzleName currentCmd currentDesc rawReply
            next

        #! reply body (multi-line, after command declaration)
        if len(trimmed) >= 6
            if trimmed[:6] == "reply "
                var content string = trim trimmed[6:]
                RegisterPuzzleCommand bot puzzleName currentCmd currentDesc content
                next

#! Register a puzzle command (wraps the handler)
fun RegisterPuzzleCommand
    bot
    puzzle
    cmd
    desc
    replyContent
    var fullName string = cmd
    var command dynamic = {"description": desc, "puzzle": puzzle, "reply": replyContent}
    var _cmds2 dynamic = bot.commands
    _cmds2[fullName] is command
    bot.commands is _cmds2

#! ==============================
#! 🚀  ZERO-BOILERPLATE BOT API
#! ==============================

#! Create a bot from environment — reads DISCORD_TOKEN, DISCORD_PREFIX
fun BotFromEnv
    var token string = os_getenv "DISCORD_TOKEN" ""
    if token == empty or token == ""
        token is os_getenv "BOT_TOKEN" ""
    if token == empty or token == ""
        say "❌ Set DISCORD_TOKEN or BOT_TOKEN in .glo or .env"
        process_exit 1
    var prefix string = os_getenv "DISCORD_PREFIX" "!"
    give QuickBot token prefix

#! Run a bot with puzzle auto-loading
fun RunWithPuzzles
    bot
    LoadPuzzles bot "puzzles"
    LoadPuzzles bot "./puzzles"
    Run bot

#! ==============================
#! ✨  CLEANER HELPERS
#! ==============================

#! Shortcut for replying to a message
fun MsgReply
    token
    msg
    content
    Send token msg.channel_id content

#! Get channel from message
fun MsgChannel
    msg
    give msg.channel_id

#! Get author from message
fun MsgAuthor
    msg
    give msg.author

#! Check if message has a prefix
fun MsgHasPrefix
    msg
    prefix
    var content string = msg.content
    if len(content) < len(prefix)
        give false
    give content[:len(prefix)] == prefix

#! Get command from prefixed message
fun MsgCommand
    msg
    prefix
    var content string = msg.content
    var rest string = content[len(prefix):]
    var parts dynamic = split rest " "
    if len(parts) == 0
        give ""
    give parts[0]

#! ==============================
#! 📋  COMMAND DEFINITION HELPER
#! ==============================

#! Define a command with a simple reply
fun SimpleCommand
    bot
    name
    desc
    reply
    var cmd dynamic = {"description": desc, "reply": reply}
    var _cmds3 dynamic = bot.commands
    _cmds3[name] is cmd
    bot.commands is _cmds3

#! Register a cog — batch-import a list of command definitions from a puzzle file.
#! Each command entry:
#!   {"name": "cmd", "desc": "Help text", "reply": "response text"}
#!   or {"name": "cmd", "desc": "Help text", "handler": handlerFunction}
fun RegisterCog
    bot
    cmds
    repeat cmd in cmds
        var name string = cmd.name
        var desc string = cmd.desc
        var reply string = cmd.reply
        if reply != empty
            SimpleCommand bot name desc reply
            next
        var handlerFunc dynamic = cmd.handler
        if handlerFunc != empty
            AddCommand bot name desc handlerFunc
            next
        var handlerName string = cmd.handler_name
        if handlerName != empty
            BotHandler bot name desc handlerName

#! ==============================
#! 🧭  CONTEXT SYSTEM (discord.py-style)
#! ==============================
#!
#! discord.py's ctx, adapted for Aether.
#! Since Aether can't store functions in dicts, use helper functions:
#!   CtxSend  ctx "text"   → sends to channel
#!   CtxReply ctx "text"   → replies to message/interaction
#!   CtxEmbed ctx embed    → sends embed
#!
#! Handler signature:  fun myHandler  ctx  args
#!   ctx.author       — the user who ran the command
#!   ctx.channel_id   — channel ID
#!   ctx.guild_id     — guild ID (empty in DMs)
#!   ctx.token        — bot token
#!   ctx.source       — raw message or interaction
#!   ctx.cmd          — command name
#!   ctx.args         — list of arguments
#!   ctx.bot          — the bot object

#! Build a context dict from command data
fun Ctx
    bot
    token
    source
    cmd
    args
    var author dynamic = {}
    var channelId string = ""
    var guildId string = ""
    if has_key source "author"
        if source.author != empty
            author is source.author
            channelId is source.channel_id
            guildId is source.guild_id
    if author == empty or author == {}
        if has_key source "member"
            author is source.member.user
            channelId is source.channel_id
            guildId is source.guild_id
    if author == empty or author == {}
        author is {"id": "", "username": "unknown"}
    give {"bot": bot, "token": token, "source": source, "cmd": cmd, "args": args, "author": author, "channel_id": channelId, "guild_id": guildId}

#! Send a message to the context's channel
fun CtxSend
    ctx
    content
    give Send ctx.token ctx.channel_id content

#! Reply to the context's source (message reply or interaction reply)
fun CtxReply
    ctx
    content
    give ReplyTo ctx.token ctx.source content

#! Send an embed to the context's channel
fun CtxEmbed
    ctx
    embed
    give SendEmbed ctx.token ctx.channel_id embed

#! Send an ephemeral (user-only) reply to an interaction
fun CtxEphemeral
    ctx
    content
    give InteractionEphemeral ctx.token ctx.source content

#! Edit the original interaction response
fun CtxEdit
    ctx
    content
    give InteractionEdit ctx.token ctx.source content

#! Get the author's user ID from context
fun CtxUserId
    ctx
    give ctx.author.id

#! Get the author's username from context
fun CtxUserName
    ctx
    give ctx.author.username

#! Check if context is from an interaction (vs message)
fun CtxIsInteraction
    ctx
    give has_key ctx.source "author" == false

#! Get the guild ID (empty string in DMs)
fun CtxGuildId
    ctx
    give ctx.guild_id

#! Get the channel ID
fun CtxChannelId
    ctx
    give ctx.channel_id
