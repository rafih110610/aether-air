def.fun: BuildHelpCatalog(bot:dynamic) -> dynamic
    def.var: entries
        dynamic
        []

    Repeat for cmd in bot["commands"]:
        def.var: name
            string
            string;
                cmd["name"]

        def.var: aliases
            dynamic
            []
        def.var: cmdHasAliases
            dynamic
            has_key;
                cmd
                "aliases"
        if cmdHasAliases:
            aliases is cmd["aliases"]

        def.var: helpText
            string
            ""
        def.var: cmdHasHelp
            dynamic
            has_key;
                cmd
                "help"
        if cmdHasHelp:
            helpText is string;
                cmd["help"]

        def.var: usageText
            string
            name
        def.var: cmdHasUsage
            dynamic
            has_key;
                cmd
                "usage"
        if cmdHasUsage:
            usageText is string;
                cmd["usage"]

        def.var: category
            string
            "general"
        def.var: cmdHasCategory
            dynamic
            has_key;
                cmd
                "category"
        if cmdHasCategory:
            category is lower;
                string(cmd["category"])

        def.var: cooldownSeconds
            int
            0
        def.var: cmdHasCooldown
            dynamic
            has_key;
                cmd
                "cooldown_seconds"
        if cmdHasCooldown:
            cooldownSeconds is int;
                cmd["cooldown_seconds"]
            if cooldownSeconds < 0:
                cooldownSeconds is 0

        def.var: entry
            dynamic
            {"name": name, "aliases": aliases, "help": helpText, "usage": usageText, "category": category, "cooldown_seconds": cooldownSeconds}
        entries is append;
            entries
            entry

    Give: entries

def.fun: BuildHelpText(bot:dynamic, categoryFilter:string) -> string
    def.var: requestedCategory
        string
        categoryFilter
    requestedCategory is trim;
        requestedCategory
    requestedCategory is lower;
        requestedCategory

    def.var: lines
        dynamic
        []

    Repeat for cmd in bot["commands"]:
        def.var: commandCategory
            string
            "general"
        def.var: hasCategory
            dynamic
            has_key;
                cmd
                "category"
        if hasCategory:
            commandCategory is lower;
                string(cmd["category"])

        if requestedCategory != "":
            if commandCategory != requestedCategory:
                NEXT

        def.var: name
            string
            string;
                cmd["name"]

        def.var: usageText
            string
            name
        def.var: hasUsage
            dynamic
            has_key;
                cmd
                "usage"
        if hasUsage:
            usageText is string;
                cmd["usage"]

        def.var: line
            string
            name + " -> " + usageText

        def.var: hasHelp
            dynamic
            has_key;
                cmd
                "help"
        if hasHelp:
            def.var: helpText
                string
                string;
                    cmd["help"]
            if helpText != "":
                line is line + " | " + helpText

        def.var: hasAliases
            dynamic
            has_key;
                cmd
                "aliases"
        if hasAliases:
            def.var: aliases
                dynamic
                cmd["aliases"]
            def.var: aliasCount
                int
                len;
                    aliases
            if aliasCount > 0:
                def.var: aliasText
                    string
                    join;
                        aliases
                        ", "
                line is line + " | aliases: " + aliasText

        lines is append;
            lines
            line

    def.var: lineCount
        int
        len;
            lines
    if lineCount == 0:
        if requestedCategory == "":
            Give: "No commands registered."
        Give: "No commands in category: " + requestedCategory

    def.var: rendered
        string
        join;
            lines
            "\n"
    Give: rendered

def.fun: BuildHelpOverviewText(bot:dynamic, prefix:string) -> string
    def.var: catalog
        dynamic
        BuildHelpCatalog;
            bot

    def.var: total
        int
        len;
            catalog

    def.var: categories
        dynamic
        []
    def.var: counts
        dynamic
        {}

    Repeat for entry in catalog:
        def.var: category
            string
            "general"
        def.var: hasCategory
            dynamic
            has_key;
                entry
                "category"
        if hasCategory:
            category is lower;
                string(entry["category"])

        def.var: hasListedCategory
            dynamic
            contains;
                categories
                category
        if not hasListedCategory:
            categories is append;
                categories
                category

        def.var: currentCount
            int
            0
        def.var: hasCount
            dynamic
            has_key;
                counts
                category
        if hasCount:
            currentCount is int;
                counts[category]

        currentCount is currentCount + 1
        counts is dict_set;
            counts
            category
            currentCount

    def.var: lines
        dynamic
        []
    lines is append;
        lines
        "Total commands: " + string(total)
    lines is append;
        lines
        "Use " + prefix + "help <category>"

    Repeat for categoryName in categories:
        def.var: categoryCount
            int
            0
        def.var: hasCategoryCount
            dynamic
            has_key;
                counts
                categoryName
        if hasCategoryCount:
            categoryCount is int;
                counts[categoryName]

        def.var: categoryLine
            string
            "- " + categoryName + " (" + string(categoryCount) + ")"
        lines is append;
            lines
            categoryLine

    def.var: rendered
        string
        join;
            lines
            "\n"
    Give: rendered

def.fun: SetPresenceActive(status:string, activities:dynamic, afk:boolean) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."

    def.var: normalizedStatus
        string
        lower;
            status
    if normalizedStatus == "offline":
        normalizedStatus is "invisible"
    if normalizedStatus != "online":
        if normalizedStatus != "idle":
            if normalizedStatus != "dnd":
                if normalizedStatus != "invisible":
                    normalizedStatus is "online"

    ActivePresenceStatus is normalizedStatus
    ActivePresenceAfk is afk
    ActivePresenceActivities is activities

    ActiveSession is dict_set;
        ActiveSession
        "presence_status"
        normalizedStatus
    ActiveSession is dict_set;
        ActiveSession
        "presence_afk"
        afk
    ActiveSession is dict_set;
        ActiveSession
        "presence_activities"
        activities
    Give: ActiveSession

def.fun: SetStatusActive(status:string) -> dynamic
    if ActiveToken == "":
        flag: "No active Discord token. Call UseToken with token first."

    def.var: activities
        dynamic
        ActivePresenceActivities
    def.var: afk
        boolean
        ActivePresenceAfk

    def.var: hasActivities
        dynamic
        has_key;
            ActiveSession
            "presence_activities"
    if hasActivities:
        activities is ActiveSession["presence_activities"]

    def.var: hasAfk
        dynamic
        has_key;
            ActiveSession
            "presence_afk"
    if hasAfk:
        afk is ActiveSession["presence_afk"]

    def.var: normalizedStatus
        string
        lower;
            status
    if normalizedStatus == "offline":
        normalizedStatus is "invisible"
    if normalizedStatus != "online":
        if normalizedStatus != "idle":
            if normalizedStatus != "dnd":
                if normalizedStatus != "invisible":
                    normalizedStatus is "online"

    ActivePresenceStatus is normalizedStatus
