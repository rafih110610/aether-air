                        "Cooldown active for `" + resolved["name"] + "`. Try again in " + string(remainingSeconds) + "s."
                    Give: {"handled": TRUE, "mode": "message", "command": resolved["name"], "channel_id": payload["channel_id"], "content": cooldownMessage, "args": resolved["args"], "raw": resolved["raw"]}

            def.var: nextAllowed
                float
                now + commandCooldownSeconds
            ActiveCommandCooldowns is dict_set;
                ActiveCommandCooldowns
                cooldownKey
                nextAllowed

    def.var: resolvedHasResponse
        dynamic
        has_key;
            resolved
            "response"
    if resolvedHasResponse:
        def.var: responseTemplate
            string
            string;
                resolved["response"]
        def.var: responseContent
