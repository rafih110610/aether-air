    Give: total

def.fun: CreateBot(prefix:string, intents:dynamic) -> dynamic
    def.var: intentsValue
        int
        ResolveIntentsValue;
            intents
    Give: {"prefix": prefix, "intents": intents, "intents_value": intentsValue, "token": "", "auth": "", "commands": [], "events": [], "ready": FALSE, "presence_status": "online", "presence_afk": FALSE, "presence_activities": []}

def.fun: WithToken(bot:dynamic, token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    def.var: intentsValue
        int
        ResolveIntentsValue;
            bot["intents"]

    def.var: presenceStatus
        string
        "online"
    def.var: botHasPresenceStatus
        dynamic
        has_key;
            bot
            "presence_status"
    if botHasPresenceStatus:
        presenceStatus is bot["presence_status"]

    def.var: presenceAfk
        boolean
        FALSE
    def.var: botHasPresenceAfk
        dynamic
        has_key;
            bot
            "presence_afk"
    if botHasPresenceAfk:
        presenceAfk is bot["presence_afk"]

    def.var: presenceActivities
        dynamic
        []
    def.var: botHasPresenceActivities
        dynamic
        has_key;
            bot
            "presence_activities"
    if botHasPresenceActivities:
        presenceActivities is bot["presence_activities"]

    Give: {"prefix": bot["prefix"], "intents": bot["intents"], "intents_value": intentsValue, "token": token, "auth": auth, "commands": bot["commands"], "events": bot["events"], "ready": FALSE, "presence_status": presenceStatus, "presence_afk": presenceAfk, "presence_activities": presenceActivities}

def.fun: Login(token:string) -> dynamic
    def.var: auth
        string
        "Bot " + token
    def.var: me
        dynamic
        http_get;
            APIBase + "/users/@me"
            auth
    Give: {"token": token, "auth": auth, "session": me}

